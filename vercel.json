{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/rules/:sport/:class",
      "destination": "/index.html?sport=:sport&class=:class"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css|svg|png|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{funnel/**,v3/W1-playbooks/CATALOG.json}"
    }
  },
  "redirects": [
    {
      "source": "/athlete/butler/",
      "destination": "/athlete/jimmy/"
    },
    {
      "source": "/athlete/coward/",
      "destination": "/athlete/cedric/"
    },
    {
      "source": "/athlete/groenewegen/",
      "destination": "/athlete/sara/"
    },
    {
      "source": "/athlete/lowe/",
      "destination": "/athlete/karsta/"
    },
    {
      "source": "/athlete/marpet/",
      "destination": "/athlete/ali/"
    },
    {
      "source": "/athlete/perez/",
      "destination": "/athlete/tori/"
    },
    {
      "source": "/athlete/pichardo/",
      "destination": "/athlete/olivia/"
    },
    {
      "source": "/athlete/pirosko/",
      "destination": "/athlete/samantha/"
    },
    {
      "source": "/athlete/renfrow/",
      "destination": "/athlete/hunter/"
    },
    {
      "source": "/athlete/rodenfels/",
      "destination": "/athlete/annie/"
    },
    {
      "source": "/athlete/rodriguez/",
      "destination": "/athlete/cristelle/"
    },
    {

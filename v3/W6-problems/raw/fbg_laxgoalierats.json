data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"group\": {\n      \"platform\": \"facebook\",\n      \"id\": \"840585376500610\",\n      \"url\": \"https://www.facebook.com/groups/840585376500610\",\n      \"name\": \"Lax Goalie Rats\",\n      \"description\": \"Lax Goalie Rats is the place for lacrosse goalies, goalie coaches, and goalie Moms and Dads to learn how to become (or train) a better lacrosse goalie and have some fun while doing so!\\n\\nThere's a saying you've got to have a screw loose in the head to play lacrosse goalie. Consider this your place to interact with other \\\"screw loose\\\" kids, coaches, and parents from around the world.\\n\\nRun by Coach Damon from LaxGoalieRat.com\",\n      \"createdAt\": \"2021-01-30T07:55:44.000Z\",\n      \"historySummary\": \"Group created on January 30, 2021\",\n      \"privacy\": {\n        \"label\": \"Public\",\n        \"description\": \"Anyone can see who's in the group and what they post.\"\n      },\n      \"visibility\": {\n        \"label\": \"Visible\",\n        \"description\": \"Anyone can find this group.\"\n      },\n      \"categories\": [],\n      \"memberCount\": 15190,\n      \"administratorCount\": 3,\n      \"moderatorCount\": 0,\n      \"administrators\": [\n        {\n          \"id\": \"pfbid05QesUShZnftumo8GS6sWXqWgRUcSbsMDqBffF1kneuvscvNFP6X4vTqcqHGHjsCRl\",\n          \"name\": \"Madi Gardner\",\n          \"url\": \"https://www.facebook.com/people/Madi-Gardner/pfbid05QesUShZnftumo8GS6sWXqWgRUcSbsMDqBffF1kneuvscvNFP6X4vTqcqHGHjsCRl/\",\n          \"profilePictureUrl\": \"https://scontent-lga3-2.xx.fbcdn.net/v/t39.30808-1/491780780_971754705161680_4850798646944822525_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx960x958&ctp=s32x32&_nc_cat=107&ccb=1-7&_nc_sid=e99d92&_nc_ohc=PLVeV_yajSMQ7kNvwE8Afbs&_nc_oc=AdrIhmvHzVTbtKqct6CHO8w-hlqm0uRlW7qhd7-Ghd-fNZTK8N0Bwr7NJQVwt8yQ57M&_nc_zt=24&_nc_ht=scontent-lga3-2.xx&_nc_gid=ONJGCs1cCcAz7cU8CTb9YQ&_nc_ss=78180&oh=00_AQQZCBpAOD_2w8B7NMDeZLOu3JJy2ObhzcuYayMPH-DjJg&oe=6AF3CA2D\"\n        },\n        {\n          \"id\": \"100049149321186\",\n          \"name\": \"Lax Goalie Rat\",\n          \"url\": \"https://www.facebook.com/LaxGoalieRat\",\n          \"profilePictureUrl\": \"https://scontent-lga3-1.xx.fbcdn.net/v/t1.6435-1/37134354_2140811569537039_199031524685774848_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx867x867&ctp=s32x32&_nc_cat=111&ccb=1-7&_nc_sid=2d3e12&_nc_ohc=RV_6O2ZTJPgQ7kNvwG3C4LC&_nc_oc=AdpfLTexWbZ9Sqw1l3ZZAZldeLQo8ceTJDvqpSK2qwlloKL8TO0GY3HmVh_tdukCeu0&_nc_zt=24&_nc_ht=scontent-lga3-1.xx&_nc_gid=ONJGCs1cCcAz7cU8CTb9YQ&_nc_ss=78180&oh=00_AQRr0tuLEjtE3QTXRfSmrNUoGJChI4HShZIXPegMrUbvVQ&oe=6B1568B1\"\n        },\n        {\n          \"id\": \"508974149\",\n          \"name\": \"Damon Daisley Wilson\",\n          \"url\": null,\n          \"profilePictureUrl\": \"https://scontent-lga3-2.xx.fbcdn.net/v/t1.6435-1/88177446_10157108047789150_8690633226990911488_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx1807x1807&ctp=s32x32&_nc_cat=101&ccb=1-7&_nc_sid=1d2534&_nc_ohc=cvRfZPx0LvkQ7kNvwF3dVlo&_nc_oc=Adqpe1XH2_JDP7JZGbQzWpHdBOK68f8CLqmYgoQk2UV2G2Oj8IBGlVn8HZgUqMT19iU&_nc_zt=24&_nc_ht=scontent-lga3-2.xx&_nc_gid=ONJGCs1cCcAz7cU8CTb9YQ&_nc_ss=78180&oh=00_AQSxE43EcdYmjbvufF3_MRHBNrj24NphM3IXpWBDN3Vmlg&oe=6B1557FB\"\n        }\n      ],\n      \"moderators\": [],\n      \"activity\": {\n        \"postsLastDay\": 7,\n        \"postsLastMonth\": 128,\n        \"newMembersText\": \"No new members in the last week\"\n      },\n      \"rules\": [\n        {\n          \"id\": \"1476726189553189\",\n          \"title\": \"Posts Offering Services Cost $40\",\n          \"description\": \"Any post advertising services to the group (camps, private coaching, lessons, job offers, etc.) cost $40. This is to help cover the cost of the admin work plus create a hurdle to weed out spam posts. Email help@laxgoalierat.com to coordinate. Service offering posts not pre-approved will be deleted.\"\n        },\n        {\n          \"id\": \"1079891339236678\",\n          \"title\": \"Lacrosse Goalie Stuff Only\",\n          \"description\": \"This is a lacrosse goalie group. All posts must in some way, shape, or form be related to goalies.\"\n        },\n        {\n          \"id\": \"1079890405903438\",\n          \"title\": \"No promotions or spam\",\n          \"description\": \"Give more than you take in this group. Spam and irrelevant links aren't allowed.\"\n        },\n        {\n          \"id\": \"1079891062570039\",\n          \"title\": \"No bullying\",\n          \"description\": \"Make sure everyone feels safe. Bullying of any kind isn't allowed. Respectable debate is one thing but bullying others to play this position how you play this position isn't allowed. Degrading comments about things like goalie padding, race, religion, culture, sexual orientation, gender or identity will not be tolerated.\"\n        },\n        {\n          \"id\": \"917360778823069\",\n          \"title\": \"Be kind and courteous\",\n          \"description\": \"Lacrosse goalies are a very small knit group. Debates over gear and techniques are fine but let's keep it positive. Lift each other up, don't tear each other down.\"\n        },\n        {\n          \"id\": \"1079891845903294\",\n          \"title\": \"Photos Are Encouraged / I may use it elsewhere\",\n          \"description\": \"Posting pics or videos of your goalie is highly encouraged. Know that I may use the pic or vid in some of my Lax Goalie Rat marketing materials.\"\n        },\n        {\n          \"id\": \"1516637048895436\",\n          \"title\": \"No Fundraisers\",\n          \"description\": \"Unfortunately it's impossible to determine which fundraisers are legit and which are scams, so the rule is no posting any fundraisers in this group.\"\n        }\n      ]\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_2b21d193-ab64-40fe-ba43-e60312d0212e\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a8-761d-7ed4-994c-4b2a08cc394d\"}"}],"structuredContent":{"data":{"lookupStatus":"found","group":{"platform":"facebook","id":"840585376500610","url":"https://www.facebook.com/groups/840585376500610","name":"Lax Goalie Rats","description":"Lax Goalie Rats is the place for lacrosse goalies, goalie coaches, and goalie Moms and Dads to learn how to become (or train) a better lacrosse goalie and have some fun while doing so!\n\nThere's a saying you've got to have a screw loose in the head to play lacrosse goalie. Consider this your place to interact with other \"screw loose\" kids, coaches, and parents from around the world.\n\nRun by Coach Damon from LaxGoalieRat.com","createdAt":"2021-01-30T07:55:44.000Z","historySummary":"Group created on January 30, 2021","privacy":{"label":"Public","description":"Anyone can see who's in the group and what they post."},"visibility":{"label":"Visible","description":"Anyone can find this group."},"categories":[],"memberCount":15190,"administratorCount":3,"moderatorCount":0,"administrators":[{"id":"pfbid05QesUShZnftumo8GS6sWXqWgRUcSbsMDqBffF1kneuvscvNFP6X4vTqcqHGHjsCRl","name":"Madi Gardner","url":"https://www.facebook.com/people/Madi-Gardner/pfbid05QesUShZnftumo8GS6sWXqWgRUcSbsMDqBffF1kneuvscvNFP6X4vTqcqHGHjsCRl/","profilePictureUrl":"https://scontent-lga3-2.xx.fbcdn.net/v/t39.30808-1/491780780_971754705161680_4850798646944822525_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx960x958&ctp=s32x32&_nc_cat=107&ccb=1-7&_nc_sid=e99d92&_nc_ohc=PLVeV_yajSMQ7kNvwE8Afbs&_nc_oc=AdrIhmvHzVTbtKqct6CHO8w-hlqm0uRlW7qhd7-Ghd-fNZTK8N0Bwr7NJQVwt8yQ57M&_nc_zt=24&_nc_ht=scontent-lga3-2.xx&_nc_gid=ONJGCs1cCcAz7cU8CTb9YQ&_nc_ss=78180&oh=00_AQQZCBpAOD_2w8B7NMDeZLOu3JJy2ObhzcuYayMPH-DjJg&oe=6AF3CA2D"},{"id":"100049149321186","name":"Lax Goalie Rat","url":"https://www.facebook.com/LaxGoalieRat","profilePictureUrl":"https://scontent-lga3-1.xx.fbcdn.net/v/t1.6435-1/37134354_2140811569537039_199031524685774848_n.jp
data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"7520328569512493838\",\n        \"text\": \"wish I found you 7 years ago for my middle son. he did land himself a wrestling scholarship and now is an assistant coach for the high school.\",\n        \"createdAt\": \"2025-06-26T18:35:53.000Z\",\n        \"likes\": 146,\n        \"replyCount\": 0,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"wendywilcox76\",\n          \"displayName\": \"wendywilcox76\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-maliva-avt-0068/823ee0ec075356142aa862f9a0316007~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=2e87b95d&x-expires=1794067200&x-signature=8XUa2KWlAl58MMaA9gAsJ3he3Pc%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6961552474100712453\",\n          \"secUid\": \"MS4wLjABAAAAwTVweCdgMO7vhgYTEJmPq_g0WMBTOvdMbqBPcZ3AXg4t8TpXiDRJuD629jvCDCVO\"\n        }\n      },\n      {\n        \"id\": \"7520400129975829279\",\n        \"text\": \"Yall should get that done their freshman year of high school the sooner the better. Don’t wait last minute cause most colleges won’t recruit your kids if they don’t have a ncaa id number\",\n        \"createdAt\": \"2025-06-26T23:13:43.000Z\",\n        \"likes\": 211,\n        \"replyCount\": 0,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"javeed_72\",\n          \"displayName\": \"javeed_72\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/b7c13f221666bb2d6d4c666147445f42~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=87ecdc9c&x-expires=1794067200&x-signature=G%2BWtJdLKzFXvBea4uCrlfHvuS4g%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7339608470137750570\",\n          \"secUid\": \"
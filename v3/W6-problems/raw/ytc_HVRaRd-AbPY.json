data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"Ugw51ujIV34VWjJY8TN4AaABAg\",\n        \"text\": \"This guy used the greg doucette intro fair enough\",\n        \"createdAt\": \"2025-11-06T16:19:12.145Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 4,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"JosiahJiggly123\",\n          \"displayName\": \"@JosiahJiggly123\",\n          \"platformUserId\": \"UC3MLDwR8V9OGYQ3ZQs38BWA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/9FJiJhlgq5yP5A2koP3pqChOTuDm52sIIuWCy0p-B71zINwr2Pcug6jgojLvWePPJnA9anXREA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@JosiahJiggly123\"\n        }\n      },\n      {\n        \"id\": \"Ugz6d6aI3GkScQeiPXJ4AaABAg\",\n        \"text\": \"Thank you very much for all of your advice! My son is a 2027 graduate from Bronx, NY, who wants to play in the NESCAC league.\",\n        \"createdAt\": \"2026-05-06T16:19:12.145Z\",\n        \"publishedTimeText\": \"6 months ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"gomezcreativemedia\",\n          \"displayName\": \"@gomezcreativemedia\",\n          \"platformUserId\": \"UCC4UAQ7F0EpmHZVEheleRSg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/GPNXyDLXWu2uKH0jbn_Jh6HdBRDN4WT-I9tyom3UjV3YiGfwz2xFpg2yULvIeadwpvEe30DUDk8=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@gomezcreativemedia\"\n        }\n      },\n      {\n        \"id\": \"UgxLPy18QvpSWvD0M_B4AaABAg\",\n        \"text\": \"Hey Chip, do you have any thoughts on reclassing in middle school? Are coaches looking at age and physical maturity, or just performance? Asking for a potential late bloomer (physically). Currently he will be 18.5 when graduating HS.\",\n        \"createdAt\": \"2025-11-06T16:19:12.145Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"GForce99\",\n          \"displayName\": \"@GForce99\",\n          \"platformUserId\": \"UCPTmH5L_9v2qTaVYyfqZx_w\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_nwbg_tfnViSGcueN0zpLQFXbRoT6g6HH-LeImr5lU=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@GForce99\"\n        }\n      },\n      {\n        \"id\": \"UgyUzchNVF1O7GzzSMN4AaABAg\",\n        \"text\": \"You mentioned that coaches could call players. Where are the coaches getting your information to call you? Do you have to register somewhere?\",\n        \"createdAt\": \"2026-05-06T16:19:12.145Z\",\n        \"publishedTimeText\": \"6 months ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC0hWUmFSZC1BYlBZGAYygwEaUBIaVWd5VXpjaE5WRjFPN0d6elNNTjRBYUFCQWciAggAKhhVQ096ZmxER1U0bS1TbTJnY2VBbWZIQ3cyC0hWUmFSZC1BYlBZQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3lVemNoTlZGMU83R3p6U01ONEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"EricK-gr1nz\",\n          \"displayName\": \"@EricK-gr1nz\",\n          \"platformUserId\": \"UCqSQxCrCwkQtI2Q55K_15fA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_n7o6KuemnfocAFaVKGOO0G8E2eQbMjcjXSttDxqTRWE1zv-z3-5uaDYxqQtOPRSSj_KA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@EricK-gr1nz\"\n        }\n      },\n      {\n        \"id\": \"Ugy9oZHxhzEGKUSfKZZ4AaABAg\",\n        \"text\": \"Can I pin me 1st reason I’m the first comment and like 2nd I learned a lot from u 3rd first view and under 14 seconds\",\n        \"createdAt\": \"2025-11-06T16:19:12.145Z\",\n        \"publishedTimeText\": \"1 year ago (edited)\",\n        \"likeCount\": 1,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"Xottic-edits\",\n          \"displayName\": \"@Xottic-edits\",\n          \"platformUserId\": \"UCkbb30PPmkXQ26IgC747usg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/xE0bDo0yrLILKw9B1qPFVR0Ns4murJsXVi2ovFLKbAHuJbVNGp5G0ZljNOeBg1JqvgB2fAl8=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@Xottic-edits\"\n        }\n      },\n      {\n        \"id\": \"UgxPMDq5C6w23ZPihOV4AaABAg\",\n        \"text\": \"Will my son get recruited for college, don’t care.\\nThe boy is going into his freshman year in HS and he is a dominant pitcher who hits bonbs and he’s a great 3rd baseman. I truly believe that if the boy does the work and the parents also do the work then it should be a recipe for success. Keep those grades up and it will be all good.\\n@book3311\",\n        \"createdAt\": \"2026-06-06T16:19:12.145Z\",\n        \"publishedTimeText\": \"5 months ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"book3311\",\n          \"displayName\": \"@book3311\",\n          \"platformUserId\": \"UC_IEG2Fvk_pKxRg9mfZ-5aA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/Su6C6zGfGBv3A9t8cR7bzvRsh83KacejdRlQSx0T2NhYIhsiLJWLRTMZ__ce0If3ufHz9e0iJA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@book3311\"\n        }\n      }\n    ],\n    \"page\": {\n      \"nextCursor\": null,\n      \"hasMore\": false\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_1ff91917-5e49-4d82-830c-6f7eea3cc
urationSec\": 112.833,\n        \"dimensions\": {\n          \"width\": 1080,\n          \"height\": 1920\n        },\n        \"carousel\": null,\n        \"audio\": {\n          \"id\": \"27449632544704210\",\n          \"title\": \"Original audio\",\n          \"artist\": \"Nicole Johnsey Burke\",\n          \"isOriginal\": true,\n          \"artistHandle\": \"heynicoleburke\"\n        },\n        \"coauthors\": [],\n        \"taggedUsers\": [],\n        \"location\": null,\n        \"isPaidPartnership\": false,\n        \"sponsors\": [],\n        \"commentsDisabled\": false,\n        \"isPinned\": false,\n        \"story\": null\n      }\n    ],\n    \"page\": {\n      \"kind\": \"cursor\",\n      \"nextCursor\": \"h1.eyJjIjoiZDBkNmMyNWE5NmQ5MmY4ZjRiNWM0ZGRlOGViNTNjYzk4NDJmN2U5Mjg4YTg0ODQ4MjkzNWNiOTNjMjQzNTkxYyIsImUiOiJYZmxmLUV1VzQyIiwiYiI6Ik9oY1JXTHBaeXoifQ\",\n      \"hasMore\": true,\n      \"start\": null,\n      \"page\": null,\n      \"count\": null,\n      \"returnedCount\": 7,\n      \"total\": null,\n      \"totalPages\": null\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_34b194a3-d69f-42c6-bfb3-271a42017eda\",\n    \"creditsCharged\": 1,\n    \"version\": \"v2\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a6-e5f5-7a03-83a5-f099e06d4768\"}"}],"structuredContent":{"data":{"media":[{"id":"4010763655207692913","shortcode":"DepGEtis6px","url":"https://www.instagram.com/reel/DepGEtis6px/","kind":"reel","mediaType":"video","caption":"What To Do Get Recruited 🔥\n\n🎁 Comment “TOOL” and I’ll send you my free college football recruiting tool that uses your athlete’s height, weight, and position to suggest a projected division level and 15 schools to explore 🎁\n\nIf your son is in 9th grade and wants to play college football, freshman year is the perfect time to start preparing for the recruiting process. Most sports parents don’t realize how important early NCAA eligibility planning, choosing the right high school core courses, and findi
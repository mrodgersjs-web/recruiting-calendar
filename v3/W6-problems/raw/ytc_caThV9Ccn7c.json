data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"UgyDy4n1LZuFsyqu1wV4AaABAg\",\n        \"text\": \"Thanks for providing this resource! Will be forwarding this onto several parents with kids who I train that are interested in potentially playing college soccer in the next 3-6 years. Great content and appreciate your channel!\",\n        \"createdAt\": \"2023-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 1,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC2NhVGhWOUNjbjdjGAYygwEaUBIaVWd5RHk0bjFMWnVGc3lxdTF3VjRBYUFCQWciAggAKhhVQ1JTWTI2YWFaOUY1WnhPUlZBMFpNWUEyC2NhVGhWOUNjbjdjQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3lEeTRuMUxadUZzeXF1MXdWNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"FrancescoSaporito13\",\n          \"displayName\": \"@FrancescoSaporito13\",\n          \"platformUserId\": \"UC5d0rPw_OyjPktjgaK033EA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/_3FFudBgXLCx-3GDV_u5UDrJ7biBNezysFwc16eHyOUxmtkvHziXiz7h_1YB1FgNUcuOjPcmrSE=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@FrancescoSaporito13\"\n        }\n      },\n      {\n        \"id\": \"UgzlKWH25j-hb9ybFKp4AaABAg\",\n        \"text\": \"LIKE THE VIDEO IF YOU LEARNED SOMETHING! 😃\",\n        \"createdAt\": \"2023-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 5,\n        \"replyCount\": 2,\n        \"repliesCursor\": \"Eg0SC2NhVGhWOUNjbjdjGAYygwEaUBIaVWd6bEtXSDI1ai1oYjl5YkZLcDRBYUFCQWciAggAKhhVQ1JTWTI2YWFaOUY1WnhPUlZBMFpNWUEyC2NhVGhWOUNjbjdjQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3psS1dIMjVqLWhiOXliRktwNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"Fitsoccerqueen\",\n          \"displayName\": \"@Fitsoccerqueen\",\n          \"platformUserId\": \"UCRSY26aaZ9F5ZxORVA0ZMYA\",\n          \"verified\": false,\n          \"creator\": true,\n          \"avatarUrl\": \"https://yt3.ggpht.com/eaH_XhBsh07faD7POV-Xfc_80tgOLnOKLKoMk5vYUATMqvzXv2H2TkQlOb-ln4BRN0kGdqepmQ=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@Fitsoccerqueen\"\n        }\n      },\n      {\n        \"id\": \"UgyX385g8yc2vZgtAD94AaABAg\",\n        \"text\": \"ID camps are a business, academy soccer is a huge business, college soccer for boys is a business some D3 schools have 50 and 60 players on roster each season, very few scholarship opportunities for boys and on top of that D1, D2 and NAIA schools are bringing kids from overseas (which is fine at the professional level but not   at college level specially for boys who barely have any scholarships available), south America and Africa to study here and the kids who have minimum financial aid, and the walk ons are the ones paying for their scholarships.\",\n        \"createdAt\": \"2024-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"2 years ago\",\n        \"likeCount\": 3,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC2NhVGhWOUNjbjdjGAYygwEaUBIaVWd5WDM4NWc4eWMydlpndEFEOTRBYUFCQWciAggAKhhVQ1JTWTI2YWFaOUY1WnhPUlZBMFpNWUEyC2NhVGhWOUNjbjdjQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3lYMzg1Zzh5YzJ2Wmd0QUQ5NEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"ricardourrutia7566\",\n          \"displayName\": \"@ricardourrutia7566\",\n          \"platformUserId\": \"UCb-pVXSExI6hoBeJ_82g2Og\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_lkDhfR4IQoQOti0IosPsSAEqhLLgtyGqmMmRGIpKBIdhtOTK_iy1Z_GU0MKBc9sh8dlA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@ricardourrutia7566\"\n        }\n      },\n      {\n        \"id\": \"Ugx6tL8qBsWacOlbInF4AaABAg\",\n        \"text\": \"Also kids and parents have to not only determine if they can afford, but they need to face question of WITHOUT SOCCER, is this the right school for my kid. A lot can happen in four years and soccer because of a lot of reasons does not work out, then what??\",\n        \"createdAt\": \"2023-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 1,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"sloanfarrell3944\",\n          \"displayName\": \"@sloanfarrell3944\",\n          \"platformUserId\": \"UCqZ9cVFlGkkWuYFaf66_Nqg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_mQolmn0KoV_EkEpYSTTM741Z7kw_MX2eZwuzZe7sA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@sloanfarrell3944\"\n        }\n      },\n      {\n        \"id\": \"Ugwqzft52OP6vBMjktR4AaABAg\",\n        \"text\": \"Great interview!!\",\n        \"createdAt\": \"2023-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 1,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC2NhVGhWOUNjbjdjGAYygwEaUBIaVWd3cXpmdDUyT1A2dkJNamt0UjRBYUFCQWciAggAKhhVQ1JTWTI2YWFaOUY1WnhPUlZBMFpNWUEyC2NhVGhWOUNjbjdjQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3dxemZ0NTJPUDZ2Qk1qa3RSNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"augiedogie23\",\n          \"displayName\": \"@augiedogie23\",\n          \"platformUserId\": \"UCVEC_DvJokFrevne3cNryEg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_lK1CwZllaF1ctkJI6Bzl5jcPa_J0CVKUl2nrHAZmQ=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@augiedogie23\"\n        }\n      },\n      {\n        \"id\": \"UgxC6LNA1z81wnmWzJd4AaABAg\",\n        \"text\": \"Been through all of this with my son 2023 college grad. One thing you did not mention coaches and shading the truth especially as to ID camps. When coaches are asked, they are going to almost every time and say they want you to go to their camps. They make money off of this. Several coaches did this to us. We also used a recruiter and they won't give him a straight answer. So son recruited three different times so he got to meet many many coaches and primarily had half truths told him consistently. Only about 4 coaches were up front with him. Coaches at D1 level get paid to win and make their money through ID camps. Please keep that in mind. They will feign interest all the way up to the end often.\",\n        \"createdAt\": \"2023-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC2NhVGhWOUNjbjdjGAYygwEaUBIaVWd4QzZMTkExejgxd25tV3pKZDRBYUFCQWciAggAKhhVQ1JTWTI2YWFaOUY1WnhPUlZBMFpNWUEyC2NhVGhWOUNjbjdjQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3hDNkxOQTF6ODF3bm1XekpkNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"sloanfarrell3944\",\n          \"displayName\": \"@sloanfarrell3944\",\n          \"platformUserId\": \"UCqZ9cVFlGkkWuYFaf66_Nqg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_mQolmn0KoV_EkEpYSTTM741Z7kw_MX2eZwuzZe7sA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@sloanfarrell3944\"\n        }\n      },\n      {\n        \"id\": \"UgzVhr_khlSjBQfk4O14AaABAg\",\n        \"text\": \"Interested in getting more information about how your program works. My son's desire is to play D1 soccer.\",\n        \"createdAt\": \"2023-11-06T16:18:39.940Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC2NhVGhWOUNjbjdjGAYygwEaUBIaVWd6VmhyX2tobFNqQlFmazRPMTRBYUFCQWciAggAKhhVQ1JTWTI2YWFaOUY1WnhPUlZBMFpNWUEyC2NhVGhWOUNjbjdjQAFICoIBAggBQi9jb21tZW50LXJlc
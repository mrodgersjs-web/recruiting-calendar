el\": null,\n        \"audio\": {\n          \"id\": \"1712744822896068\",\n          \"title\": \"Original audio\",\n          \"artist\": \"Isaac Hadac\",\n          \"isOriginal\": true,\n          \"artistHandle\": \"coach_hadac\"\n        },\n        \"coauthors\": [\n          {\n            \"id\": \"55115999279\",\n            \"handle\": \"5starfbrecruiting\",\n            \"displayName\": \"5 Star Football Recruiting\",\n            \"avatarUrl\": \"https://scontent-lax3-2.cdninstagram.com/v/t51.82787-19/544836866_17991025463839280_1520122933707173649_n.jpg?stp=dst-jpg_e0_s150x150_tt6&_nc_cat=106&ig_cache_key=GAKNeSAwyuoJvuo-ABFvihbBjxgVbmNDAQAB1501500j-ccb7-5&ccb=7-5&_nc_sid=669407&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=IumxTw8INbAQ7kNvwHND2Id&_nc_oc=AdpnPXZjt_yJL8hTaVwxSow95dsLiJbnPsVKD9isXP4zLU-vVOl4b_7xHkaEtvSq6hI&_nc_ad=z-m&_nc_cid=0&_nc_zt=24&_nc_ht=scontent-lax3-2.cdninstagram.com&_nc_gid=jT35p9eKZ_u0Ytb1BCKOwQ&_nc_ss=723ba&oh=00_AQT7ii8_tvoj2MGn-CQmAZHIJkBEnmfaaIT_i03B7bYl5A&oe=6AF3CE73\",\n            \"verified\": false,\n            \"privateAccount\": false\n          }\n        ],\n        \"taggedUsers\": [],\n        \"location\": {\n          \"id\": \"227362428\",\n          \"name\": \"Verona High School\",\n          \"lat\": 40.841048888501,\n          \"lng\": -74.247383973356\n        },\n        \"isPaidPartnership\": false,\n        \"sponsors\": [],\n        \"commentsDisabled\": false,\n        \"isPinned\": false,\n        \"story\": null\n      },\n      {\n        \"id\": \"3872423771626401263\",\n        \"shortcode\": \"DW9nOc_ke3v\",\n        \"url\": \"https://www.instagram.com/reel/DW9nOc_ke3v/\",\n        \"kind\": \"reel\",\n        \"mediaType\": \"video\",\n        \"caption\": \"The biggest mistake I see parents make?\\n\\nLiving through there  athlete instead of supporting them.\\nAnd listen there are two sides to this.\\nOf course, being invested, excited, and proud is a beautiful thing.\\n\\nBut at the end of the day…\\nyou have to ask yourself the hard questions:\\nDo you tense up when they make mistakes?\\nDo you feel embarrassed or frustrated?…\\nNot for them, but for you??\\n\\nDo you want them to succeed for their journey… or for how it reflects on you?\\n\\nBecause athletes feel that.\\n\\nAnd when it becomes about you, it adds pressure they were never meant to carry.\\n\\nThis process is already hard enough.\\nThe goal should be to create an environment where they feel supported, free, and confident to grow.\\n\\nNot one where they feel like they have to perform for approval.\\n\\nIt’s a fine linebut one worth being aware of.\\n\\nAnd honestly… making that shift doesn’t just help your athlete,\\nit brings you a lot more peace too.\\n\\nParents if you’re serious about helping your athlete navigate the recruiting process the right way, comment RECRUIT.\",\n        \"altText\": null,\n        \"createdAt\": \"2026-04-10T19:23:04.000Z\",\n        \"owner\": {\n          \"id\": \"58576398678\",\n          \"handle\": \"izimurray_\",\n          \"displayName\": \"Izi Murray | Soccer | Motivation | Entrepreneur\",\n          \"avatarUrl\": \"https://scontent-lax3-2.cdninstagram.com/v/t51.2885-19/412147745_1567182080746439_5739825672836000237_n.jpg?stp=dst-jpg_e0_s150x150_tt6&_nc_cat=107&ig_cache_key=GCHgkBjHozgDWJEFAO2pDt4J9adPbkULAAAB1501500j-ccb7-5&ccb=7-5&_nc_sid=669407&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=ed3PhctFIHEQ7kNvwEdkPlY&_nc_oc=AdoKDHnv-MXcf7BlJOtrX8L_bOSTfcC0ntSkOUI7F8Uo8xGOj1ICZ3_aK99HmSNdEiQ&_nc_ad=z-m&_nc_cid=0&_nc_zt=24&_nc_ht=scontent-lax3-2.cdninstagram.com&_nc_ss=723ba&oh=00_AQSuGDFSPO1F-k7BBreCXtQodQAfJuMT5sb519PAEFML4A&oe=6AF3EB10\",\n          \"verified\": true,\n          \"privateAccount\": false\n        },\n        \"metrics\": {\n          \"likeCount\": 222,\n          \"commentCount\": 20,\n          \"playCount\": 12477,\n          \"shareCount\": 62,\n          \"saveCount\": n
       \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": {\n          \"id\": \"00c3e46c3d0cac08\",\n          \"name\": \"Frisco\",\n          \"fullName\": \"Frisco, TX\",\n          \"country\": \"United States\",\n          \"countryCode\": \"US\",\n          \"placeType\": \"city\"\n        },\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      }\n    ],\n    \"people\": [],\n    \"page\": {\n      \"nextCursor\": \"\",\n      \"hasMore\": true\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_76d93bee-131c-4d76-9926-6cb18d63a8d4\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a8-764c-7ab7-98d9-e36c6f7b5a4f\"}"}],"structuredContent":{"data":{"tweets":[{"id":"2017276696874119462","url":"https://x.com/coachdrew94/status/2017276696874119462","text":"For 95% of student-athletes chasing college opportunities, the recruiting process feels like a roller coaster.\n👉 You get excited when a coach follows you.\n👉 You get discouraged when that same coach ghosts you.\nUp… down… up… down. Just like a ride.\nBut here’s the thing: you don’t want to end up where you started.And that’s what happens if you’re only riding onerecruiting roller coaster.\nThe key is to be on multiple radars.The more coaches who know your name, the better your chances.\nThat’s where I come in. Working with me means getting on the radar of multiple college coaches—not just one or two.\nIf you’re serious about not finishing where you started, have your parents visit my website and complete the financial aid application.\nDon’t waste time. Let’s get moving.\n– Coach Drew","createdAt":"2026-01-30T16:40:18.000Z","createdAtUnix":1769791218,"createdAtLabel":null,"language":"en","conversationI
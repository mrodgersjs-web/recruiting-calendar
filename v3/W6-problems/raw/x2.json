data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"tweets\": [\n      {\n        \"id\": \"2017276696874119462\",\n        \"url\": \"https://x.com/coachdrew94/status/2017276696874119462\",\n        \"text\": \"For 95% of student-athletes chasing college opportunities, the recruiting process feels like a roller coaster.\\n👉 You get excited when a coach follows you.\\n👉 You get discouraged when that same coach ghosts you.\\nUp… down… up… down. Just like a ride.\\nBut here’s the thing: you don’t want to end up where you started.And that’s what happens if you’re only riding onerecruiting roller coaster.\\nThe key is to be on multiple radars.The more coaches who know your name, the better your chances.\\nThat’s where I come in. Working with me means getting on the radar of multiple college coaches—not just one or two.\\nIf you’re serious about not finishing where you started, have your parents visit my website and complete the financial aid application.\\nDon’t waste time. Let’s get moving.\\n– Coach Drew\",\n        \"createdAt\": \"2026-01-30T16:40:18.000Z\",\n        \"createdAtUnix\": 1769791218,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"2017276696874119462\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"coachdrew94\",\n          \"displayName\": \"Coach Drew's Recruiting Service - 27 yrs. exp.\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/coachdrew94\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1667193117597143040\",\n          \"bio\": \"If you're a 27' player with 0 offers, still looking, not ready to give up, I can help you find offers. https://t.co/KBP0klXNsL\",\n          \"location\": \"Serving families nationwide\",\n          \"website\": \"https://coachdrew93.com/\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1667193117597143040/1793728987/1500x500\",\n          \"accountCreatedAt\": \"2023-06-09T15:33:27.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": null,\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 16335,\n            \"following\": 7408,\n            \"tweets\": 4435,\n            \"favourites\": 15,\n            \"listedCount\": 5,\n            \"mediaCount\": 146\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 2,\n          \"retweets\": 0,\n          \"replies\": 0,\n          \"quotes\": 0,\n          \"views\": 568,\n          \"bookmarkCount\": 0\n        },\n        \"media\": [],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1989779655822651800\",\n        \"url\": \"https://x.com/CoachBeede/status/1989779655822651800\",\n        \"text\": \"Dear Parents : When your “ Recruiting service” tells you a Post Grad Year is a WASTE OF TIME , please do me a favor and have him watch this 👇\\n@bsblbluebook \\n\\nhttps://www.facebook.com/share/v/1Gs1LAfTYv/?mibextid=wwXIfr\",\n        \"createdAt\": \"2025-11-15T19:36:52.000Z\",\n        \"createdAtUnix\": 1763235412,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1989779655822651800\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"CoachBeede\",\n          \"displayName\": \"Coach Beede\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2063659131026788352/AE8IYAiH_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/CoachBeede\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"262857654\",\n          \"bio\": \"Coach Beede, helping families since 1987. Guiding families through the athletic and academic process. Join the Clubhouse at https://t.co/ZRqGb094Qd\",\n          \"location\": \"Boston\",\n          \"website\": \"https://CoachBeede.com\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/262857654/1780849733/1500x500\",\n          \"accountCreatedAt\": \"2011-03-08T22:22:00.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": {\n            \"type\": \"Creator\",\n            \"category\": [\n              {\n                \"id\": 800,\n                \"name\": \"Sports, Fitness & Recreation\",\n                \"icon_name\": \"IconBriefcaseStroke\"\n              }\n            ],\n            \"restId\": \"1468598668643082243\"\n          },\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 50087,\n            \"following\": 13162,\n            \"tweets\": 49329,\n            \"favourites\": 161839,\n            \"listedCount\": 99,\n            \"mediaCount\": 3680\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 17,\n          \"retweets\": 4,\n          \"replies\": 1,\n          \"quotes\": 1,\n          \"views\": 7414,\n          \"bookmarkCount\": 2\n        },\n        \"media\": [],\n        \"expandedUrl\": \"https://www.facebook.com/share/v/1Gs1LAfTYv/?mibextid=wwXIfr\",\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": \"Twitter for iPhone\",\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [\n            {\n              \"handle\": \"bsblbluebook\",\n              \"displayName\": \"Bluebook Sports™\",\n              \"platformUserId\": \"251408354\"\n            }\n          ],\n          \"urls\": [\n            {\n              \"url\": \"https://www.facebook.com/share/v/1Gs1LAfTYv/?mibextid=wwXIfr\",\n              \"displayUrl\": \"https://www.facebook.com/share/v/1Gs1LAfTYv/?mibextid=wwXIfr\",\n              \"expandedUrl\": \"https://www.facebook.com/share/v/1Gs1LAfTYv/?mibextid=wwXIfr\"\n            }\n          ],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1989370960437473488\",\n        \"url\": \"https://x.com/coachdrew94/status/1989370960437473488\",\n        \"text\": \"Prospect Camps: What Parents Need to Know\\n\\nParents often ask me whether their son should attend a prospect camp. My answer always starts with one key question: Is the camp school‑specific, or is it open‑ended with a lot of different coaches?\\n\\nSchool‑specific camps are my preference. Why? Because your son gets direct exposure to the coaches at that school without being lost in a sea of competition. It’s focused, targeted, and far more valuable.\\n\\nMulti‑school camps can also be worthwhile, but only if the schools are aligned — either in the same conference (like the Ivy League) or on the same academic/athletic level. That way, your son is showcasing himself to programs that truly fit his profile.\\n\\nUnknown or unfocused camps are where I draw the line. If I don’t know the schools involved, I won’t recommend them. Sending your son blindly into a camp without clarity on who’s watching is a waste of time, money, and opportunity.\\n\\nThe bottom line: Prospect camps can be powerful tools, but only when they’re strategic. The right camp puts your son in front of the right coaches, at the right level, with the right opportunities. Anything else is just noise.\",\n        \"createdAt\": \"2025-11-14T16:32:52.000Z\",\n        \"createdAtUnix\": 1763137972,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1989370960437473488\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"coachdrew94\",\n          \"displayName\": \"Coach Drew's Recruiting Service - 27 yrs. exp.\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/coachdrew94\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1667193117597143040\",\n          \"bio\": \"If you're a 27' player with 0 offers, still looking, not ready to give up, I can help you find offers. https://t.co/KBP0klXNsL\",\n          \"location\": \"Serving families nationwide\",\n          \"website\": \"https://coachdrew93.com/\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1667193117597143040/1793728987/1500x500\",\n          \"accountCreatedAt\": \"2023-06-09T15:33:27.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": null,\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 16335,\n            \"following\": 7408,\n            \"tweets\": 4435,\n            \"favourites\": 15,\n            \"listedCount\": 5,\n            \"mediaCount\": 146\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 2,\n          \"retweets\": 1,\n          \"replies\": 0,\n          \"quotes\": 0,\n          \"views\": 1262,\n          \"bookmarkCount\": 2\n        },\n        \"media\": [],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1950966620697813358\",\n        \"url\": \"https://x.com/coachdrew94/status/1950966620697813358\",\n        \"text\": \"If you’re a 27’ or younger player going to generic showcases you and your parents have no idea what you’re doing. It is a waste of time and money. Your chances of impressing a coach is less than 5%. If you’re in that 1-5% category, then go. If not, work on your strength, speed, skills and GRADES. Next year you’ll increase your chances and maybe the coach likes what he sees. Coach Drew\",\n        \"createdAt\": \"2025-07-31T17:07:44.000Z\",\n        \"createdAtUnix\": 1753981664,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1950966620697813358\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"coachdrew94\",\n          \"displayName\": \"Coach Drew's Recruiting Service - 27 yrs. exp.\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/coachdrew94\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1667193117597143040\",\n          \"bio\": \"If you're a 27' player with 0 offers, still looking, not ready to give up, I can help you find offers. https://t.co/KBP0klXNsL\",\n          \"location\": \"Serving families nationwide\",\n          \"website\": \"https://coachdrew93.com/\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1667193117597143040/1793728987/1500x500\",\n          \"accountCreatedAt\": \"2023-06-09T15:33:27.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": null,\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 16335,\n            \"following\": 7408,\n            \"tweets\": 4435,\n            \"favourites\": 15,\n            \"listedCount\": 5,\n            \"mediaCount\": 146\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 3,\n          \"retweets\": 0,\n          \"replies\": 0,\n          \"quotes\": 0,\n          \"views\": 1047,\n          \"bookmarkCount\": 0\n        },\n        \"media\": [],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1912644328289366444\",\n        \"url\": \"https://x.com/coachdrew94/status/1912644328289366444\",\n        \"text\": \"The Recruiting Roller Coaster 🎢\\nFor 95% of student-athletes chasing college opportunities, the recruiting process feels like a roller coaster.\\n👉 You get excited when a coach follows you.\\n👉 You get discouraged when that same coach ghosts you.\\nUp… down… up… down. Just like a ride.\\nBut here’s the thing: you don’t want to end up where you started. And that’s what happens if you’re only riding one recruiting roller coaster.\\nThe key is to be on multiple radars.The more coaches who know your name, the better your chances.\\nThat’s where I come in. Working with me means getting on the radar of multiple college coaches—not just one or two.\\nIf you’re serious about not finishing where you started, have your parents visit my website and complete the financial aid application.\\nDon’t waste time. Let’s get moving.\\n– Coach Drew\",\n        \"createdAt\": \"2025-04-16T23:08:37.000Z\",\n        \"createdAtUnix\": 1744844917,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1912644328289366444\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"coachdrew94\",\n          \"displayName\": \"Coach Drew's Recruiting Service - 27 yrs. exp.\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/coachdrew94\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1667193117597143040\",\n          \"bio\": \"If you're a 27' player with 0 offers, still looking, not ready to give up, I can help you find offers. https://t.co/KBP0klXNsL\",\n          \"location\": \"Serving families nationwide\",\n          \"website\": \"https://coachdrew93.com/\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1667193117597143040/1793728987/1500x500\",\n          \"accountCreatedAt\": \"2023-06-09T15:33:27.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": null,\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 16335,\n            \"following\": 7408,\n            \"tweets\": 4435,\n            \"favourites\": 15,\n            \"listedCount\": 5,\n            \"mediaCount\": 146\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 2,\n          \"retweets\": 0,\n          \"replies\": 0,\n          \"quotes\": 0,\n          \"views\": 1026,\n          \"bookmarkCount\": 0\n        },\n        \"media\": [],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1898868428074570065\",\n        \"url\": \"https://x.com/MRittCGS/status/1898868428074570065\",\n        \"text\": \"Just saw a price for a package for a private football recruiting service for 1 year…..$4,000\\n\\n$4,000….\\n\\n-No NIL Help or advisement \\n\\n-Said it will make “one personalized graphic” (which you can do for free) \\n\\n-Camp and Showcase “advisement”\\n\\n-College Search Tool (can do that on your own) \\n\\n-“Online Player Profile with your contact info” (Can do that for free with your Twitter account)\\n\\nParents/High School Football recruits please do your homework during the recruiting process…..don’t waste spending $4,000 on stuff you can do for free\",\n        \"createdAt\": \"2025-03-09T22:48:07.000Z\",\n        \"createdAtUnix\": 1741560487,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1898868428074570065\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"MRittCGS\",\n          \"displayName\": \"Mike Rittelmann\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/1987621066563272704/QOcY9iQ5_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/MRittCGS\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1618648482\",\n          \"bio\": \"Strategic Account Manager | PlayOn Sports / MaxPreps Advantage\\n🏈 Director of Scouting & Player Personnel | @CGSAllStar\\n🇨🇦 Area Scout | @calstampeders\",\n          \"location\": \"Pittsburgh, PA\",\n          \"website\": \"http://cgsallstar.com\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1618648482/1606853002/1500x500\",\n          \"accountCreatedAt\": \"2013-07-24T21:35:09.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": null,\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 23128,\n            \"following\": 11088,\n            \"tweets\": 21553,\n            \"favourites\": 37475,\n            \"listedCount\": 26,\n            \"mediaCount\": 6104\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 8,\n          \"retweets\": 1,\n          \"replies\": 1,\n          \"quotes\": 0,\n          \"views\": 2546,\n          \"bookmarkCount\": 0\n        },\n        \"media\": [],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1875605123751461015\",\n        \"url\": \"https://x.com/coachdrew94/status/1875605123751461015\",\n        \"text\": \"The average coach of my program to the parents after all the financial aid is $725. Of course, some people will pay a little more and some pay as little as $495. If you go to a Perfect Game or Showball, the cost with transportation, logging and food can run as much as $1,500 or more. That’s a one-time event. Usually for 90% of the players it is a waste of money and time. My program goes till either you tell me to stop or when the player goes to college. A one-time fee to have ME contact coaches for your boy. Go to my website. Coach Drew\",\n        \"createdAt\": \"2025-01-04T18:08:03.000Z\",\n        \"createdAtUnix\": 1736014083,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1875605123751461015\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"coachdrew94\",\n          \"displayName\": \"Coach Drew's Recruiting Service - 27 yrs. exp.\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/coachdrew94\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1667193117597143040\",\n          \"bio\": \"If you're a 27' player with 0 offers, still looking, not ready to give up
w%3D%3D&vvpl=1&l=202611061617168E428D9EB566D30D7E00&btag=e00090000\",\n          \"downloadWithoutWatermarkUrl\": \"https://v19.tiktokcdn-us.com/5c983b31ec4d55989c65828ea87c69ea/6aee523c/video/tos/useast8/tos-useast8-ve-0068c002-tx2/owB8R4DAnOQfGIpcdDSgVdmEQBiFIEnfEEAAuu/?a=1233&bti=NEBzNTY6QGo6OjZALnAjNDQuYCMxNDNg&&bt=915&ft=arR-IqgwmILPD12WWPEI3wUl1ApcMeF~O5&mime_type=video_mp4&rc=ZjplNDxmOjtpaDdnNWZpOkBpamhzdms5cjxqeDMzaTczNEAwXmIwMWExNV4xMGAwMC0wYSMtcy4tMmRrMGJgLS1kMTJzcw%3D%3D&vvpl=1&l=202611061617168E428D9EB566D30D7E00&btag=e00090000\"\n        }\n      },\n      {\n        \"id\": \"7701840720964996366\",\n        \"caption\": \"Parents, if you don’t want to stress out after your kid submits applications, here’s three things that need to happen. Too many students think they’re DONE once they hit submit. But submitting the application is only part of the process! Here are 3 things every student needs to do after applying: ✅ 1. Check college portals regularly. Make sure transcripts, recommendation letters, test scores (if submitting), and any other application materials have been received. An application isn’t complete just because it was submitted! ✅ 2. Check the Recommenders and FERPA section of the Common App. Confirm that recommendation requests and other required items have been handled and that there aren’t any outstanding tasks. ✅ 3. Check email regularly. Colleges may contact students about missing materials, important next steps, honors program invitations, or special scholarship opportunities. Missing an email could mean missing an opportunity! Parents, you can help by reminding your student to stay on top of these responsibilities, but make sure THEY take ownership of the process. Hitting submit is not the finish line. Staying organized and following through is just as important. Follow us for more no-nonsense college admissions advice, practical application strategies, and tips to help your teenager navigate the admissions process with confidence. #CollegeAdmissions #CollegeApplications #CommonApp #CollegePlanning #HighSchoolSenior\",\n        \"createdAt\": \"2026-10-28T21:55:47.000Z\",\n        \"url\": \"https://www.tiktok.com/@dobler.college.co/video/7701840720964996366\",\n        \"thumbnailUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-p-85c255-tx/oce7hkApLMJt36zOeNXNHDVFfghAnCBxAC8JEQ~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast8&ps=13740610&refresh_token=fb3cf652&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=4CPLrASrgG6d6hA%2BK7R7yYRftM0%3D\",\n        \"durationMs\": 164900,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 64724,\n          \"likes\": 1668,\n          \"comments\": 24,\n          \"shares\": 2132,\n          \"saves\": 1481\n        },\n        \"media\": {\n          \"downloadUrl\": \"https://v19.tiktokcdn-us.com/13f3c1aff7b428c095f68d0dd0e31365/6aee5291/video/tos/useast5/tos-useast5-v-85c255-tx/oMe4Bf5ywi6SE8bMtQqgiBPiIYBmE5U4vDYSQB/?a=1233&bti=NEBzNTY6QGo6OjZALnAjNDQuYCMxNDNg&&bt=939&ft=arR-IqgwmILPD12WWPEI3wUl1ApcMeF~O5&mime_type=video_mp4&rc=ZzQ2aDc1aThnaDM5NDg6PEBpM2Y0bXM5cnM5ZTQzZzM2NEBgY2NiLmI0XmMxMy5jMzNiYSNwNW5qMmRjcmVhLS1kLS9zcw%3D%3D&vvpl=1&l=202611061617168E428D9EB566D30D7E00&btag=e00090000\",\n          \"downloadWithoutWatermarkUrl\": \"https://v19.tiktokcdn-us.com/69987270a23d852d459cad43c40cce40/6aee5291/video/tos/useast5/tos-useast5-v-85c255-tx/o4MeHgeGkQmfDoVg03LwHxZNEC2JiI7SLgqLIA/?a=1233&bti=NEBzNTY6QGo6OjZALnAjNDQuYCMxNDNg&&bt=1050&ft=arR-IqgwmILPD12WWPEI3wUl1ApcMeF~O5&mime_type=video_mp4&rc=aTc8ODc3ODM6OWhoZ2hnNkBpM2Y0bXM5cnM5ZTQzZzM2NEBfXzMtNF5hX2AxXzMzLTNhYSNwNW5qMmRjcmVhLS1kLS9zcw%3D%3D&vvpl=1&l=202611061617168E428D9EB566D30D7E00&btag=e00090000\"\n        }\n      },\n      {\n        \"id\": \"7666856242333224205\",\n        \"caption\": \"Parents Can’t Want Recruiting More Than Their Athlete #fyp #recruitingtips #parenttips #collegerecruiting #highschoolathlete\",\n        \"createdAt\": \"2026-07-31T11:00:00.000Z\",\n        \"url\": \"https://www.tiktok.com/@thecoachapproachhq/video/7666856242333224205\",\n        \"thumbnailUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-p-0068-tx/osDiF1EBimgxanVIYbv66kBA54EIYmiJPUlUa~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast8&ps=13740610&refresh_token=938b060f&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=LrgZ3%2BM8smCfi9CWrr5efIYGWDQ%3D\",\n        \"durationMs\": 77043,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 4563,\n          \"likes\": 130,\n          \"comments\": 1,\n          \"shares\": 51,\n          \"saves\": 13\n        },\n        \"media\": {\n          \"downloadUrl\": null,\n          \"downloadWithoutWatermarkUrl\": null\n        }\n      },\n      {\n        \"id\": \"7617284508894727438\",\n        \"caption\": \"Parent Behavior at Camps #recruitingtips #collegerecruiting #highschoolathlete #parenttips #fyp\",\n        \"createdAt\": \"2026-03-21T11:00:00.000Z\",\n        \"url\": \"https://www.tiktok.com/@thecoachapproachhq/video/7617284508894727438\",\n        \"thumbnailUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-p-0068-tx/oYQ2QHDkRCytAGDp2FeXf6iGqb7EUEBgS6gABC~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast8&ps=13740610&refresh_token=b3446e64&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=JogzIfDZ6z5i5Bvfwx4PlROICbw%3D\",\n        \"durationMs\": 62667,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 735,\n          \"likes\": 39,\n          \"comments\": 1,\n          \"shares\": 8,\n          \"saves\": 6\n        },\n        \"media\": {\n          \"downloadUrl\": null,\n          \"downloadWithoutWatermarkUrl\": null\n        }\n      },\n      {\n        \"id\": \"7647611917460114719\",\n        \"caption\": \"Three questions every college coach will ask you on a phone call and how to answer them the right way Knowing what to say in these moments is what separates athletes who get offers from athletes who get ghosted 👇 Have you thought about what you want to study: Saying \\\"I have no idea\\\" tells the coach you are not serious about your future. Mention two majors you are considering and ask if either one stands out at their school Why are you interested in our program: Saying \\\"it looks like a great place to play\\\" makes it obvious you did not do your homework. Mention one academic and one athletic thing that drew you in and ask if that lines up with what their athletes typically find interesting What are you looking for in a college program: Saying \\\"I just want to play at the highest level\\\" tells the coach you only care about yourself. Talk about wanting a program that competes hard but also values education, then ask what makes their program a fit for athletes like you The right answers flip the entire conversation 🎯 now the coach is selling their program to you instead of evaluating you #collegerecruiting #scholarship #scholarships\",\n        \"createdAt\": \"2026-06-04T18:40:21.000Z\",\n        \"url\": \"https://www.tiktok.com/@troycagleofficial/video/7647611917460114719\",\n        \"thumbnailUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast8-p-0068-tx2/oIrIz0UgDH0GeCajAbqT4eIULIAjxKQlCox3eg~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast8&ps=13740610&refresh_token=83e9aa0c&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=R95wiW107JWGR%2FnDSbvuI%2FcSxxI%3D\",\n        \"durationMs\": 89238,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 109772,\n          \"likes\": 8577,\n          \"comments\": 20,\n          \"shares\": 1414,\n          \"saves\": 5004
data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"posts\": [\n      {\n        \"id\": \"3188175778022863\",\n        \"url\": \"https://www.facebook.com/groups/1723720494468406/permalink/3188175778022863/\",\n        \"text\": null,\n        \"publishedAt\": \"2026-11-05T18:18:47.000Z\",\n        \"reactionCount\": 0,\n        \"commentCount\": 0,\n        \"isPaidPartnership\": null,\n        \"sharedPostId\": null,\n        \"sharedPostUrl\": null,\n        \"author\": {\n          \"id\": \"604773291\",\n          \"name\": \"Kuartez James\",\n          \"url\": null\n        },\n        \"video\": {\n          \"thumbnailUrl\": null,\n          \"durationMs\": null,\n          \"sdUrl\": null,\n          \"hdUrl\": null\n        }\n      },\n      {\n        \"id\": \"3184726891701085\",\n        \"url\": \"https://www.facebook.com/groups/1723720494468406/permalink/3184726891701085/\",\n        \"text\": \"Welcome to all of our new parents!\\n\\nIf this is your first time going through the college recruiting process, you're in the right place. It can be overwhelming, and nobody expects you to know everything on day one.\\n\\nThat's what this group is here for. Ask questions. Learn. Help each other. And most importantly, keep showing up.\\n\\nAround here you'll hear me say it all the time:\\n\\nSHOW UP. TRUST THE PROCESS.\\n\\nNew parents, introduce yourselves:\\nSport | Graduation Year | State\\n\\nAnd if you have a recruiting question, drop that too. There's probably another parent here wondering the exact same thing.\\n\\nWelcome to the group.\\n\\nCoach Kuartez\",\n        \"publishedAt\": \"2026-11-02T22:14:39.000Z\",\n        \"reactionCount\": 0,\n        \"commentCount\": 0,\n        \"isPaidPartnership\": null,\n        \"sharedPostId\": null,\n        \"sharedPostUrl\": null,\n        \"author\": {\n          \"id\": \"604773291\",\n          \"name\": \"Kuartez James\",\n          \"url\": null\n        },\n        \"video\": {\n          \"thumbnailUrl\": null,\n          \"durationMs\": null,\n          \"sdUrl\": null,\n          \"hdUrl\": null\n        }\n      },\n      {\n        \"id\": \"3184729628367478\",\n        \"url\": \"https://www.facebook.com/groups/1723720494468406/permalink/3184729628367478/\",\n        \"text\": \"Welcome to all of our new parents!\\n\\nIf this is your first time going through the college recruiting process, you're in the right place. It can be overwhelming, and nobody expects you to know everything on day one.\\n\\nThat's what this group is here for. Ask questions. Learn. Help each other. And most importantly, keep showing up.\\n\\nAround here you'll hear me say it all the time:\\n\\nSHOW UP. TRUST THE PROCESS.\\n\\nNew parents, introduce yourselves:\\nSport | Graduation Year | State\\n\\nAnd if you have a recruiting question, drop that too. There's probably another parent here wondering the exact same thing.\\n\\nWelcome to the group.\\n\\nCoach Kuartez\",\n        \"publishedAt\": \"2026-11-02T22:18:23.000Z\",\n        \"reactionCount\": 0,\n        \"commentCount\": 0,\n        \"isPaidPartnership\": null,\n        \"sharedPostId\": null,\n        \"sharedPostUrl\": null,\n        \"author\": {\n          \"id\": \"604773291\",\n          \"name\": \"Kuartez James\",\n          \"url\": null\n        },\n        \"video\": {\n          \"thumbnailUrl\": null,\n          \"durationMs\": null,\n          \"sdUrl\": null,\n          \"hdUrl\": null\n        }\n      },\n      {\n        \"id\": \"3178708135636294\",\n        \"url\": \"https://www.facebook.com/groups/1723720494468406/permalink/3178708135636294/\",\n        \"text\": \"My 2029 T&F girlie has a call with a D3 coach tonight! We’ve been casting her net wide to see what might be a fit while filling out recruiting questionnaires and this coach emailed her right away asking to chat. She knows it’s super early and is nervous as all get up. She’s got questions written down and has been practicing for what the coach may ask her. Any tips on how to quell the nervous especially since she’s so young?\",\n        \"publishedAt\": \"2026-10-28T21:44:12.000Z\",\n        \"reactionCount\": 5,\n        \"commentCount\": 8,\n        \"isPaidPartnership\": null,\n        \"sharedPostId\": null,\n        \"sharedPostUrl\": null,\n        \"author\": {\n          \"id\": \"28817268637967414\",\n          \"name\": \"Anonymous participant\",\n          \"url\": null\n        },\n        \"video\": {\n          \"thumbnailUrl\": null,\n          \"durationMs\": null,\n          \"sdUrl\": null,\n          \"hdUrl\": null\n        }\n      }\n    ],\n    \"page\": {\n      \"nextCursor\": \"AQHTR6dbYi1Xrmai73wfDUTCdWccUFNE7DJKJirT3_K9y84BcZVedylsRBeZPOMkvWhmvTaA0YnjH7GbpU0pfSigcA:eyIwIjoxNzkzOTgxOTE4LCIxIjo3NjgyLCIzIjoxLCI0IjoxLCI1IjoyLCI2IjotMSwiNyI6LTEsIjgiOi0xfQ==\",\n      \"hasMore\": true\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_6fb9677c-b077-454d-8985-e00f19202940\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a7-a9b5-7ca5-8f8d-87a7236fdeac\"}"}],"structuredContent":{"data":{"lookupStatus":"found","posts":[{"id":"3188175778022863","url":"https://www.facebook.com/groups/1723720494468406/permalink/3188175778022863/","text":null,"publishedAt":"2026-11-05T18:18:47.000Z","reactionCount":0,"commentCount":0,"isPaidPartnership":null,"sharedPostId":null,"sharedPostUrl":null,"author":{"id":"604773291","name":"Kuartez James","url":null},"video":{"thumbnailUrl":null,"durationMs":null,"sdUrl":null,"hdUrl":null}},{"id":"3184726891701085","url":"https://www.facebook.com/groups/1723720494468406/permalink/3184726891701085/","text":"Welcome to all of our new parents!\n\nIf this is your first time going through the college recruiting process, you're in the right place. It can be overwhelming, and nobody expects you to know everything on day one.\n\nThat's what thi
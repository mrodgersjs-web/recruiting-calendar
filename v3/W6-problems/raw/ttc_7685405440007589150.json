data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"7685454906954416909\",\n        \"text\": \"Exactly! We handled everything when it came to recruiting. We did our research, talked to friends whose kids were being recruited, playing D1, or already in the pros, sent his information to schools, and set up his Twitter. His coaches did absolutely nothing, and we didn’t expect them to. We knew it was on my son and us as his parents, and it paid off. He ended up with 12 D1 offers!\",\n        \"createdAt\": \"2026-09-14T18:10:59.000Z\",\n        \"likes\": 123,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"msmo1120\",\n          \"displayName\": \"Monique\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/5c7dfc076b90eb6cc29e02b8113c24e4~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=27d09456&x-expires=1794067200&x-signature=sYQwgMzU8m4bSFID6t0dwkn%2FA78%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"6817621674582770693\",\n          \"secUid\": \"MS4wLjABAAAAHZbrIiPHT47ufi12G-tnzrHHtIrnxdIJhF6mr2pHU1fcHPcvmnpr3cWFJKgpeRu3\"\n        }\n      },\n      {\n        \"id\": \"7686572162639954718\",\n        \"text\": \"I’m already overwhelmed and don’t even know where to start. I feel so dumb!\",\n        \"createdAt\": \"2026-09-17T18:27:11.000Z\",\n        \"likes\": 12,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"brittanywatersdds\",\n          \"displayName\": \"brittanywatersdds\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/64c6418c217861d9cc656666322da13d~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=c7248cc5&x-expires=1794067200&x-signature=9qOBTrrsMpVsKRwkGCnOxyZCgM4%3D&t=4d5b
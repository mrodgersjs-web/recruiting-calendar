data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"group\": {\n      \"platform\": \"facebook\",\n      \"id\": \"224305324333304\",\n      \"url\": \"https://www.facebook.com/groups/224305324333304\",\n      \"name\": \"Wrestlers Only!!!\",\n      \"description\": \"A place for wrestlers and friends. We don't want hate, just love. We are all brothers and sisters of the mat. We need to come together and save our Sport!!!  Please add video or pictures of matches and use this as your Facebook wrestling page!!! We support all combat sports!!!\",\n      \"createdAt\": \"2012-03-05T04:24:41.000Z\",\n      \"historySummary\": \"Group created on March 5, 2012\",\n      \"privacy\": {\n        \"label\": \"Public\",\n        \"description\": \"Anyone can see who's in the group and what they post.\"\n      },\n      \"visibility\": {\n        \"label\": \"Visible\",\n        \"description\": \"Anyone can find this group.\"\n      },\n      \"categories\": [],\n      \"memberCount\": 246335,\n      \"administratorCount\": 2,\n      \"moderatorCount\": 0,\n      \"administrators\": [\n        {\n          \"id\": \"pfbid0268b913crrGcRQiCbcpXLkp3SMA3SQzjb4yBodEPM1tTrvhujtXoryDA6cbGW2hbil\",\n          \"name\": \"Lisa Welsh\",\n          \"url\": \"https://www.facebook.com/patrick.begouen\",\n          \"profilePictureUrl\": \"https://scontent.fsac1-2.fna.fbcdn.net/v/t1.30497-1/453178253_471506465671661_2781666950760530985_n.png?stp=cp0_dst-png&cstp=mx2048x2048&ctp=s32x32&_nc_cat=1&ccb=1-7&_nc_sid=136b72&_nc_ohc=6WY2Kqhyid0Q7kNvwEcPym7&_nc_oc=AdqmAx1FkU6f-jsJc2WfPNuGMgVWPkNUzOf1pf6xC_cl2o2C_xulKcxxAhwi9aezeZ4&_nc_zt=24&_nc_ht=scontent.fsac1-2.fna&_nc_ss=78180&oh=00_AQQe3OTv_7ScRNQl_H94pCjzFGmPy9yVxLszss1oie86rQ&oe=6B155AFA\"\n        },\n        {\n          \"id\": \"pfbid02JVzQeNUPJxkG3SWfcyCryWAvXpEMpzHPj8sNKMGv4CPsC4u4xFfbvFnyvBde1P91l\",\n          \"name\": \"Zelda Middleton\",\n          \"url\": \"https://www.facebook.com/suthasinee.nu.3\",\n          \"profilePictureUrl\": \"https://scontent.fsac1-2.fna.fbcdn.net/v/t1.30497-1/453178253_471506465671661_2781666950760530985_n.png?stp=cp0_dst-png&cstp=mx2048x2048&ctp=s32x32&_nc_cat=1&ccb=1-7&_nc_sid=136b72&_nc_ohc=6WY2Kqhyid0Q7kNvwEcPym7&_nc_oc=AdqmAx1FkU6f-jsJc2WfPNuGMgVWPkNUzOf1pf6xC_cl2o2C_xulKcxxAhwi9aezeZ4&_nc_zt=24&_nc_ht=scontent.fsac1-2.fna&_nc_ss=78180&oh=00_AQQe3OTv_7ScRNQl_H94pCjzFGmPy9yVxLszss1oie86rQ&oe=6B155AFA\"\n        }\n      ],\n      \"moderators\": [],\n      \"activity\": {\n        \"postsLastDay\": 57,\n        \"postsLastMonth\": 1119,\n        \"newMembersText\": \"No new members in the last week\"\n      },\n      \"rules\": [\n        {\n          \"id\": \"2520734104690403\",\n          \"title\": \"No cursing – the F-word, S-word, B-word, etc.\",\n          \"description\": null\n        },\n        {\n          \"id\": \"2403083179788830\",\n          \"title\": \"Slam Posts/ Question Calls/ Any Tips/ bash refs\",\n          \"description\": \"Posts and comments must be wrestling-related and appropriate for children and adults of all ages.   This means no cursing and no sexual content at all. NO IS THIS A SLAM POST/ Ask your coach for TIPS! No questioning the Refs decision move on and learn not to keep it in the refs hands\"\n        },\n        {\n          \"id\": \"2520736221356858\",\n          \"title\": \"No selling anything or fundraising w/o permission\",\n          \"description\": \"No selling anything or fundraising without explicit admin permission you ask for first. There are appropriate fundraisers that happen for coaches or wrestlers with a disease or something like that.\"\n        },\n        {\n          \"id\": \"2520734594690354\",\n          \"title\": \"No sexual content at all/ NO MEDICAL ADVICE\",\n          \"description\": \"Be very careful commenting on female wrestler posts or questions involving gender issues. No posts or comments insulting another member.No medical advice go see your doctor!!!\"\n        },\n        {\n          \"id\": \"2520737358023411\",\n          \"title\": \"Inappropriate Content/ Comments/ Coach Bashing!!!\",\n          \"description\": \"Please be respectful to others. If you don’t like what you see please keep scrolling!!! Please NO COACH bashing sit down with the individual and have a conversation!!!\"\n        },\n        {\n          \"id\": \"2520738381356642\",\n          \"title\": \"No posts on weight loss, cutting, or ringworm post\",\n          \"description\": \"No posts discussing weight loss, weight cutting, or supplements. Check with an admin prior to posting something you want to say or ask and we can help you ask correctly. No draining ears go see a doc! No skin funk questions go see a doc!!! NO MEDICAL ADVICE ASK A DOCTOR!!!\"\n        },\n        {\n          \"id\": \"2520739721356508\",\n          \"title\": \"No street fights./ Duplicate Posts/ Limit Posts!!!\",\n          \"description\": \"No street fights or videos of people behaving badly and \\\"wrestling\\\" Helps nobody, not appropriate. No duplicate posts of tournaments or information!!! Please limit the number of posts!!!\"\n        },\n        {\n          \"id\": \"2520741168023030\",\n          \"title\": \"No bashing others/ Refs /NO PRO Wrestling!!!\",\n          \"description\": \"No posts bashing other sports or activities. Basketball and football or other wrestlers!!! We want to discuss, promote, amateur wrestling. No Pro Wrestling we are amateur only!\"\n        },\n        {\n          \"id\": \"2520742448022902\",\n          \"title\": \"We cannot see your post change settings/ resubmit\",\n          \"description\": \"Please change your settings from private to public so we can see content of post!!!/ Please resubmit the video or post for review. Sometimes Facebook declines the content or admin have not discussed if it’s approved!!!\"\n        },\n        {\n          \"id\": \"2520739148023232\",\n          \"title\": \"No politics\",\n          \"description\": \"No discussion of or mentions of politics, politicians, political parties, politics leanings, euphemisms for politics, or any language that can be possibly construed as political in nature.Or post that will incite political comments and opinions!!!\"\n        }\n      ]\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_c619a8d5-a2df-403e-836b-8e44f0d451aa\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a8-f347-7553-b762-9565f6d26040\"}"}],"structuredContent":{"data":{"lookupStatus":"found","group":{"platform":"facebook","id":"224305324333304","url":"https://www.facebook.com/groups/224305324333304","name":"Wrestlers Only!!!","description":"A place for wrestlers and friends. We don't want hate, just love. We are all brothers and sisters of the mat. We need to come together and save our Sport!!!  Please add video or pictures of matches and use this as your Facebook wrestling page!!! We support all combat sports!!!","createdAt":"2012-03-05T04:24:41.000Z","historySummary":"Group created on March 5, 2012","privacy":{"label":"Public","description":"Anyone can see who's in the group and what they post."},"visibility":{"label":"Visible","description":"Anyone can find this group."},"categories":[],"memberCount":246335,"administratorCount":2,"moderatorCount":0,"administrators":[{"id":"pfbid0268b913crrGcRQiCbcpXLkp3SMA3SQzjb4yBodEPM1tTrvhujtXoryDA6cbGW2hbil","name":"Lisa Welsh","url":"https://www.facebook.com/patrick.begouen","profilePictureUrl":"https://scontent.fsac1-2.fna.fbcdn.net/v/t1.30497-1/453178253_471506465671661_2781666950760530985_n.png?stp=cp0_dst-png&cstp=mx2048x2048&ctp=s32x32&_nc_cat=1&ccb=1-7&_nc_sid=136b72&_nc_ohc=6WY2Kqhyid0Q7kNvwEcPym7&_nc_oc=AdqmAx1FkU6f-jsJc2WfPNuGMgVWPkNUzOf1pf6xC_cl2o2C_xulKcxxAhwi9aezeZ4&_nc_zt=24&_nc_ht=scontent.fsac1-2.fna&_nc_ss=78180&oh=00_AQQe3OTv_7ScRNQl_H94pCjzFGmPy9yVxLszss1oie86rQ&oe=6B155AFA"},{"id"
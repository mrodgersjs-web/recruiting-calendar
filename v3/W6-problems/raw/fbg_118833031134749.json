e group."},{"id":"873111139040264","title":"Rule #5","description":"Share personal experiences respectfully\nYou may talk about your own journey—what worked for you, what didn’t—but you cannot present personal experiences as a judgment of a specific team or staff"},{"id":"873111712373540","title":"Rule #6","description":"Keep posts collegiate-athletics focused\nOnly topics related to college swimming and diving recruiting or preparation (training, academics, timelines, mental health, etc.) are allowed."},{"id":"873113979039980","title":"Rule #7","description":"No posting athlete stats to seek placement help\nPosts like “my athlete swims these times—what schools should they target?” are not allowed. Members may ask how to build a school list, not for other people to build it for them."},{"id":"873114735706571","title":"Rule #8","description":"Respect privacy\nDo not share private messages, emails, offers, or conversations with coaches."},{"id":"873115229039855","title":"Rule #9","description":"Be kind and respectful\nHarassment, rude behavior, or attacking comments will not be allowed."},{"id":"873116399039738","title":"Rule #10","description":"Admins reserve the right to remove posts\nAdmins may delete posts or turn off comments to keep the group aligned with its purpose."}]}},"meta":{"requestId":"req_050e595d-2823-4e5d-b90e-08911c16f1dd","creditsCharged":1,"version":"v1"},"card":{"kind":"profile","title":"College Swimming and Diving Recruiting Help","subtitle":"Public","platform":"Facebook","headline":"We are offering this Facebook Group to help swimmers, divers and parents have a better understanding of the college recruiting process. I have seen so much inaccurate information and advice being offered on the other sit","verified":false,"metrics":[{"label":"Members","value":"23k"},{"label":"Posts / day","value":"2"},{"label":"Posts / month","value":"51"}],"details":["Created 28 Feb 2023","No new members in the last week"],"href":"https://www.facebook.com/groups/118
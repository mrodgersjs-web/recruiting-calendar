bid0y9xyiAKsEtYuZ6DicmLTrjKW3AuqWDRDSk8RZmnnFyN9Kywr4h11whSzhfaJ697Kl\",\n          \"name\": \"Spencer Scarth\",\n          \"url\": null,\n          \"profilePictureUrl\": \"https://scontent-lga3-1.xx.fbcdn.net/v/t39.30808-1/399680386_10223088567017689_8992137450375142858_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx1080x1080&ctp=s32x32&_nc_cat=111&ccb=1-7&_nc_sid=e99d92&_nc_ohc=lJBJDkkJfX4Q7kNvwHBESlr&_nc_oc=AdozsgkzR19LRm8LB9vjMuRLJMO4Cor7WE-a2C9kTREXhN-nK3-Z_YhBR7bmouEhH2g&_nc_zt=24&_nc_ht=scontent-lga3-1.xx&_nc_gid=JpyTBKIzYlKrRH-XT8Z8pg&_nc_ss=78180&oh=00_AQQHmlUAGbyZTv0PWsj9U3eP0_AkfxB1Acaq5JE-bXC6_g&oe=6AF3B9DA\"\n        },\n        {\n          \"id\": \"pfbid0YC4K3xQm5LxQZE8CGt9dzPRBu2Vk2tFVE12pksVRyv6GkG9bXAHhiWUyj6V9Xe7Rl\",\n          \"name\": \"Colleen Kelly\",\n          \"url\": null,\n          \"profilePictureUrl\": \"https://scontent-lga3-2.xx.fbcdn.net/v/t39.30808-1/778972547_10165687305598306_7036112564975756616_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx1086x1094&ctp=s32x32&_nc_cat=100&ccb=1-7&_nc_sid=e99d92&_nc_ohc=ZfcGVEHPM_sQ7kNvwHMQapb&_nc_oc=Adq-uzyKNtrzoEu9HGcCEzONVAh7OCDzKgRqb6eEUsVyho0tjHRoQk_FlGdE3ezyX8Y&_nc_zt=24&_nc_ht=scontent-lga3-2.xx&_nc_gid=JpyTBKIzYlKrRH-XT8Z8pg&_nc_ss=78180&oh=00_AQRd32JYEpd1qFyUsGaJnmNPwzyLc-tUoQI5ycC1AOQBZA&oe=6AF3D1AF\"\n        },\n        {\n          \"id\": \"pfbid0tLpoG9DvKuUotdcDgUjSXy8LeNwWC148XSLTxraJRRdHk2RGkLwwXft6ukmNwAbrl\",\n          \"name\": \"Mike de Bear\",\n          \"url\": null,\n          \"profilePictureUrl\": \"https://scontent-lga3-2.xx.fbcdn.net/v/t39.30808-1/850009261_10175465044565507_8337142593436164087_n.jpg?stp=cp0_dst-jpg_tt6&cstp=mx854x854&ctp=s32x32&_nc_cat=105&ccb=1-7&_nc_sid=e99d92&_nc_ohc=iChzksa4IhoQ7kNvwF1cBVB&_nc_oc=AdrraByUA4g22ZHXd6-PtvDX0Mjc4liwOMZcER_ffKQMzAwXj8ltDjTzETEgKWZ0NQo&_nc_zt=24&_nc_ht=scontent-lga3-2.xx&_nc_gid=JpyTBKIzYlKrRH-XT8Z8pg&_nc_ss=78180&oh=00_AQQuOhVrZfnRUu5nhh12DhHSD-A7RIBS60-XkdAkBA8jow&oe=6AF3C8E2\"\n        }\n      ],\n      \"moderators\": [],\n      \"activity\": {\n        \"postsLastDay\": 2,\n        \"postsLastMonth\": 51,\n        \"newMembersText\": \"No new members in the last week\"\n      },\n      \"rules\": [\n        {\n          \"id\": \"873109229040455\",\n          \"title\": \"Rule #1\",\n          \"description\": \"This group is for general advice only. Discussion should focus on helping families understand the college swimming & diving recruiting process (timelines, communication, visits, NCAA rules, training questions, etc.).\\nIt is not a place to promote or recruit for specific teams.\"\n        },\n        {\n          \"id\": \"873109755707069\",\n          \"title\": \"Rule #2\",\n          \"description\": \"No soliciting or promoting colleges, coaches, or programs\\nMembers may not post advertisements, “my school is looking for swimmers,” roster needs, or anything resembling a recruiting pitch.\"\n        },\n        {\n          \"id\": \"873110142373697\",\n          \"title\": \"Rule #3\",\n          \"description\": \"No asking for opinions about specific colleges\\nPosts asking, “What do you think about XYZ University?” or “How is their coach?” are no longer allowed. These conversations often lead to speculation, misinformation, or negative commentary.\"\n        },\n        {\n          \"id\": \"873110585706986\",\n          \"title\": \"Rule #4\",\n          \"description\": \"No bashing colleges, programs, coaches, or athletes\\nThis group should remain positive and supportive. Negative comments about any school or staff member will be removed and repeat offenders may be removed from the group.\"\n        },\n        {\n          \"id\": \"873111139040264\",\n          \"title\": \"Rule #5\",\n          \"description\": \"Share personal experiences respectfully\\nYou may talk about your own journey—what worked for you, what didn’t—but you cannot present personal experiences as a judgment of a specific team or staff\"\n        },\n        {\n          \"id\": \"873111712373540\",\n          \"title\": \"Rule #6\",\n          \"description\": \"Keep posts collegiate-athletics focused\\nOnly topics related to college swimming and diving recruiting or preparation (training, academics, timelines, mental health, etc.) are allowed.\"\n        },\n        {\n          \"id\": \"873113979039980\",\n          \"title\": \"Rule #7\",\n          \"description\": \"No posting athlete stats to seek placement help\\nPosts like “my athlete swims these times—what schools should they target?” are not allowed. Members may ask how to build a school list, not for other people to build it for them.\"\n        },\n        {\n          \"id\": \"873114735706571\",\n          \"title\": \"Rule #8\",\n          \"description\": \"Respect privacy\\nDo not share private messages, emails, offers, or conversations with coaches.\"\n        },\n        {\n          \"id\": \"873115229039855\",\n          \"title\": \"Rule #9\",\n          \"description\": \"Be kind and respectful\\nHarassment, rude behavior, or attacking comments will not be allowed.\"\n        },\n        {\n          \"id\": \"873116399039738\",\n          \"title\": \"Rule #10\",\n          \"description\": \"Admins reserve the right to remove posts\\nAdmins may delete posts or turn off comments to keep the group aligned with its purpose.\"\n        }\n      ]\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_050e595d-2823-4e5d-b90e-08911c16f1dd\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a7-a936-79bd-98ac-de20ae4a7010\"}"}],"structuredContent":{"data":{"lookupStatus":"found","group":{"platform":"facebook","id":"118833031134749","url":"https://www.facebook.com/groups/118833031134749","name":"College Swimming and Diving Recruiting Help","description":"We are offering this Facebook Group to help swimmers, divers and parents have a better understanding of the college recruiting process. I have seen so much inaccurate information and advice being offered on the other sites that I felt like we had an obligation to offer accurate and honest advice based on our experience as former college swim coaches. \nWe will keep everyone up to date on new NCAA rules and recruiting trends. We will offer advice based on our many years of experience in swimming. \nWe will have qualified parents and former college swimmer and divers offer advice as well as current college swimming and diving coaches. \nWe will be available to answer questions. \nWe are not offering this Facebook page to sign up more families into our program. There are no requirements to have access to our page and be able to ask questions.\nIf anybody becomes interested in our personalized recruiting education program, they are free to inquire.\nWe look forward on getting to know you all.","createdAt":"2023-02-28T17:38:00.000Z","historySummary":"Group created on February 28, 2023","privacy":{"label":"Public","description":"Anyone can see who's in the group and what they post."},"visibility":{"label":"Visible","description":"Anyone can find this group."},"categories":[],"memberCount":22730,"administratorCount":6,"moderatorCount":0,"administrators":[{"id":"pfbid02tzihdFDZ3PSnhiSAihqM1N2zpdQgeswdQHv2kFmXPZBaa1LT8XKkYc8GowjUdhjxl","name":"Kevin Timothy Weldon","url":"https://www.facebook.com/kdawg0516","profilePictureUrl":"https://scontent-lga3-2.xx.fbcdn.net/v/t39.30808-1/615411478_2038347030040985_1161526979581803183_n.jpg?stp=c0.403.1024.1024a_cp0_dst-jpg_tt6&cstp=mx1024x1024&ctp=s32x32&_nc_cat=100&ccb=1-7&_nc_sid=e99d92&_nc_ohc=iotyS7uYAkkQ7kNvwGFJbox&_nc_oc=AdoEJvUjMvbY5sdCx4u4np64gAme4bjWag086ixJmvg5jni85V0e0gy-9JWsKR7Ry-0&_nc_zt=24&_nc_ht=scontent-lga3-2.xx&_nc_gid=JpyTBKIzYlKrRH-XT8Z8pg&_nc_ss=78180&oh=00_AQTn_cQlxGKX6YoJps4BNOaoCsm1C5Zq0v0Ae4PtzQqFjw&oe=6AF3D783"},{"id":"pfbid02GH1jZ28YuSkbhQXDEqFjDDLB8APWD7adrbuHiTzqzRpFi7V8oXUKAU4rnYTtEp4Ml","name":"Lori Ryder Payne","url":null,"profilePictureUrl":"https://scontent-lga3-3.xx.fbcdn.n
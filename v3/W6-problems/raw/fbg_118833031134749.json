data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"group\": {\n      \"platform\": \"facebook\",\n      \"id\": \"118833031134749\",\n      \"url\": \"https://www.facebook.com/groups/118833031134749\",\n      \"name\": \"College Swimming and Diving Recruiting Help\",\n      \"description\": \"We are offering this Facebook Group to help swimmers, divers and parents have a better understanding of the college recruiting process. I have seen so much inaccurate information and advice being offered on the other sites that I felt like we had an obligation to offer accurate and honest advice based on our experience as former college swim coaches. \\nWe will keep everyone up to date on new NCAA rules and recruiting trends. We will offer advice based on our many years of experience in swimming. \\nWe will have qualified parents and former college swimmer and divers offer advice as well as current college swimming and diving coaches. \\nWe will be available to answer questions. \\nWe are not offering this Facebook page to sign up more families into our program. There are no requirements to have access to our page and be able to ask questions.\\nIf anybody becomes interested in our personalized recruiting education program, they are free to inquire.\\nWe look forward on getting to know you all.\",\n      \"createdAt\": \"2023-02-28T17:38:00.000Z\",\n      \"historySummary\": \"Group created on February 28, 2023\",\n      \"privacy\": {\n        \"label\": \"Public\",\n        \"description\": \"Anyone can see who's in the group and what they post.\"\n      },\n      \"visibility\": {\n        \"label\": \"Visible\",\n        \"description\": \"Anyone can find this group.\"\n      },\n      \"categories\": [],\n      \"memberCount\": 22730,\n      \"administratorCount\": 6,\n      \"moderatorCount\": 0,\n      \"administrators\": [\n        {\n          \"id\": \"pfbid02tzihdFDZ3PSnhiSAihqM1N2zpdQgeswdQHv2kFmXPZBaa1LT8XKk
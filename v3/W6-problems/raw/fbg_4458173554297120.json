data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"group\": {\n      \"platform\": \"facebook\",\n      \"id\": \"4458173554297120\",\n      \"url\": \"https://www.facebook.com/groups/4458173554297120\",\n      \"name\": \"Recruiting Discussion: Parent-to-Parent Women&#x2019;s College Lacrosse\",\n      \"description\": \"Please note: To join, there are membership questions you must answer. Please look for the button to answer the membership questions after you’ve clicked “join.”\\n\\nThe recruiting process can be confusing! This is a page dedicated to learning about the recruiting process for women’s lacrosse.\",\n      \"createdAt\": \"2021-10-24T13:36:56.000Z\",\n      \"historySummary\": \"Group created on October 24, 2021. Name last changed on December 5, 2023.\",\n      \"privacy\": {\n        \"label\": \"Private\",\n        \"description\": \"Only members can see who's in the group and what they post.\"\n      },\n      \"visibility\": {\n        \"label\": \"Visible\",\n        \"description\": \"Anyone can find this group.\"\n      },\n      \"categories\": [],\n      \"memberCount\": 8347,\n      \"administratorCount\": 0,\n      \"moderatorCount\": 0,\n      \"administrators\": [],\n      \"moderators\": [],\n      \"activity\": {\n        \"postsLastDay\": 4,\n        \"postsLastMonth\": 207,\n        \"newMembersText\": \"No new members in the last week\"\n      },\n      \"rules\": [\n        {\n          \"id\": \"4458237514290724\",\n          \"title\": \"No current or former college or club coaches.\",\n          \"description\": \"This group is intended to allow for an open discussion by parents whose kids are learning about and going through the college recruiting process for women’s lacrosse. For this reason, this group is not for current or former college coaches or club directors/coaches. If there is something you would like to share with our members, please PM an admin to discuss.\"\n        },\n        {\n          \"id\": \"4458237527624056\",\n          \"title\": \"Be kind and courteous\",\n          \"description\": \"We're all in this together to create a welcoming environment. Let's treat everyone with respect. Healthy debates are natural, but kindness is required. This includes your posts and comments on this page and your public behavior. We strive for a respectful community and work hard to maintain that.\"\n        },\n        {\n          \"id\": \"4458237520957390\",\n          \"title\": \"No hate speech or bullying\",\n          \"description\": \"Make sure everyone feels safe. Bullying of any kind isn't allowed, and degrading comments about things like race, religion, culture, sexual orientation, gender or identity will not be tolerated.\"\n        },\n        {\n          \"id\": \"4458237517624057\",\n          \"title\": \"No promotions or spam\",\n          \"description\": \"Give more than you take in this group. Self-promotion, spam and irrelevant links aren't allowed.\"\n        },\n        {\n          \"id\": \"4458237524290723\",\n          \"title\": \"Respect everyone's privacy\",\n          \"description\": \"Being part of this group requires mutual trust. Authentic, expressive discussions make groups great, but may also be sensitive and private. What's shared in the group should stay in the group.\"\n        },\n        {\n          \"id\": \"8231609666953471\",\n          \"title\": \"Accurate information.\",\n          \"description\": \"Please do your best to ensure you are providing accurate information. Misinformation will be deleted. Message an admin with any questions if you have a comment deleted for this reason.\"\n        },\n        {\n          \"id\": \"28156753580679118\",\n          \"title\": \"Questions for Admins?\",\n          \"description\": \"If you have questions about moderation, a removed post or comment, or any other administrative decision, please message an admin directly. We are happy to explain our decisions privately. Public posts or comments challenging moderation decisions are not permitted and may result in removal from the group. With over 8,000 members, the group is administered by the admin team, not by member vote.\"\n        }\n      ]\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_cfc36c64-cb58-41ed-b05a-b9ae9e4ca8f7\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1a8-f16a-7cb9-944d-fb595868c5ad\"}"}],"structuredContent":{"data":{"lookupStatus":"found","group":{"platform":"facebook","id":"4458173554297120","url":"https://www.facebook.com/groups/4458173554297120","name":"Recruiting Discussion: Parent-to-Parent Women&#x2019;s College Lacrosse","description":"Please note: To join, there are membership questions you must answer. Please look for the button to answer the membership questions after you’ve clicked “join.”\n\nThe recruiting process can be confusing! This is a page dedicated to learning about the recruiting process for women’s lacrosse.","createdAt":"2021-10-24T13:36:56.000Z","historySummary":"Group created on October 24, 2021. Name last changed on December 5, 2023.","privacy":{"label":"Private","description":"Only members can see who's in the group and what they post."},"visibility":{"label":"Visible","description":"Anyone can find this group."},"categories":[],"memberCount":8347,"administratorCount":0,"moderatorCount":0,"administrators":[],"moderators":[],"activity":{"postsLastDay":4,"postsLastMonth":207,"newMembersText":"No new members in the last week"},"rules":[{"id":"4458237514290724","title":"No current or former college or club coaches.","description":"This group is intended to allow for an open discussion by parents whose kids are learning about and going through the college recruiting process for women’s lacrosse. For this reason, this group is not for current or former college coaches or club directors/coaches. If there is something you would li
data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"7460123808294585134\",\n        \"text\": \"Helped 3 kids through the admission process. Best thing I did was to keep a list of “to do’s” and put it aside. Then do periodic check-ins/talks. Kept me from nagging & preserved sanity all around!\",\n        \"createdAt\": \"2025-01-15T12:50:58.000Z\",\n        \"likes\": 8,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"penelopegenx\",\n          \"displayName\": \"Penelope\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/d5ca2fe6209435c0a47f964f845966cf~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=1e3fa67e&x-expires=1794067200&x-signature=FSyiI%2BgCA1Xm%2FAcAs2bHyHH0XXw%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7230172591058404398\",\n          \"secUid\": \"MS4wLjABAAAAUC1r37KykGVgAlluPhBpPkVWvyCcOYKnkLs5htMFsWzqPxY17C9zQ_fi97PTAPlq\"\n        }\n      },\n      {\n        \"id\": \"7459642274587902750\",\n        \"text\": \"I moved out at 17 and 100% figured out all that on my own.\",\n        \"createdAt\": \"2025-01-14T05:42:12.000Z\",\n        \"likes\": 6,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"specialk047\",\n          \"displayName\": \"speacialk47\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/fc52e89f55bf20353579697bb29b7faf~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=ed67f519&x-expires=1794067200&x-signature=HOQbibTP6tb4DszkE056zW0WeGI%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6775563476271481861\",\n          \"secUid\": \"MS4wLjABAAAApZNpjexhhFIOondlxBhZAybC97jQSHiDHL09zG0eoD5GnIGquIAKCyMZ4wBzxBEJ\"\n        }\n      },\n      {\n        \"id\": \"7459536034968142638\",\n        \"text\": \"I have junior as well. I’m already stressed\",\n        \"createdAt\": \"2025-01-13T22:49:45.000Z\",\n        \"likes\": 9,\n        \"replyCount\": 5,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"konjit99\",\n          \"displayName\": \"user2348990346068\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/musically-maliva-obj/1594805258216454~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=c043984f&x-expires=1794067200&x-signature=N6aGIRwjGaTIxlykkM%2FXo5BweKM%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7041197090463024134\",\n          \"secUid\": \"MS4wLjABAAAAXSmnlfIDfPxQBX_LVWQkkkFmER1XJoPb_w703Dd-vxxXIPk5oCwtkx_HGpgeIKfi\"\n        }\n      },\n      {\n        \"id\": \"7481428528446341919\",\n        \"text\": \"Love your content! 🥰\",\n        \"createdAt\": \"2025-03-13T22:44:02.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"blancasiguenza03\",\n          \"displayName\": \"blancasig0929\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/7351638094371618858~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=579dd936&x-expires=1794067200&x-signature=Et0aqnoMhnWzJ0gGUMC8ERhctiE%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7074706559981847594\",\n          \"secUid\": \"MS4wLjABAAAAap1fLyBYaWRq6Vz30h24LjQ4l9cCJt4F8C0i4nKF8Y2-7Fk6W_xpF5Fj3zXv-FSq\"\n        }\n      },\n      {\n        \"id\": \"7478906689631240990\",\n        \"text\": \"I’m So grateful both my kids played sports and earned athletic scholarships to college. Made the school selection much easier\",\n        \"createdAt\": \"2025-03-07T03:37:58.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"kimsluss\",\n          \"displayName\": \"kimsluss\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/02b3063789f1d5ea2d12afc8c67d8bcc~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=3dd89789&x-expires=1794067200&x-signature=G2PwoRhq6nzrc6%2BeW%2FhfHAwILWw%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7007896285537698822\",\n          \"secUid\": \"MS4wLjABAAAAKEO4RMKvSFdvSZKxW-6fVFHgqW_s6Ku2gswgH68fEiPhkBi7hBldd3e-rhiNQMgV\"\n        }\n      },\n      {\n        \"id\": \"7478142532397794078\",\n        \"text\": \"So many parents are misinformed and do not know how to prepare their kids for college.\",\n        \"createdAt\": \"2025-03-05T02:12:45.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"earnwithdoug\",\n          \"displayName\": \"Doug I Launch & Earn\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/a0f5e5b9e467c1cd53c269dc77516ebf~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=18089726&x-expires=1794067200&x-signature=YBxxiXx0EhG9zryt4e%2FqSbud7TU%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7309286872344380458\",\n          \"secUid\": \"MS4wLjABAAAA6SqzNv4XeOsaj0EohCz92TtlSK-lwWcybYKCEzlCluRXunsA-s_xeL9YjjPIE1yw\"\n        }\n      },\n      {\n        \"id\": \"7477663906040660778\",\n        \"text\": \"What if I have a child that feels that he does not need college to achieve his goals. He is very bright in AP classes but feels that he can learn more teaching himself than former education. Urrg!\",\n        \"createdAt\": \"2025-03-03T19:15:39.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"debra1380\",\n          \"displayName\": \"debra1380\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/musically-maliva-obj/1594805258216454~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=c043984f&x-expires=1794067200&x-signature=N6aGIRwjGaTIxlykkM%2FXo5BweKM%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7091668829537797163\",\n          \"secUid\": \"MS4wLjABAAAAYP-h1X2Dr26z3KON1cX2OUyiJ8BPTMR2G7BWv_RJGziJ36ufzLDyYni25OBUdP4e\"\n        }\n      },\n      {\n        \"id\": \"7470756252626125614\",\n        \"text\": \"Do most schools look at weighted or unweighted GPA? Struggling with the fact that her weighted GPA is a 4.2 and unweighted is a 3.75 🙃\",\n        \"createdAt\": \"2025-02-13T04:30:10.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"heatherbowen7783\",\n          \"displayName\": \"Heather Bowen\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/6cac44a659ac3e09cc935126b99c8dc5~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=7edcb1b1&x-expires=1794067200&x-signature=U12Om%2F%2F6oQthcK17xb8WSMYDxUA%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6748804314096321541\",\n          \"secUid\": \"MS4wLjABAAAAcTXTmX3fDAazR7w34z1a_FIyt1HBcZHGEH5G_sEHzH79LrRWJUt1S4R4QPrkP4pu\"\n        }\n      },\n      {\n        \"id\": \"7470737851064337195\",\n        \"text\": \"I have a senior and two juniors... the stress is unreal\",\n        \"createdAt\": \"2025-02-13T03:18:37.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"ronihannaruss\",\n          \"displayName\": \"Roni Hanna Russ\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-maliva-avt-0068/7336725629624287238~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=0b20143a&x-expires=1794067200&x-signature=KGqWD23%2FxYLRUgO1lzztArYqny8%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6710933976319034374\",\n          \"secUid\": \"MS4wLjABAAAA8NY_U0WvGSlJ2ZliFOguh-o5ICI71ezV0cOPDs-Vu5LsRBIxtUQZP5m3zSxJ3R4Q\"\n        }\n      },\n      {\n        \"id\": \"7470204242112889630\",\n        \"text\": \"My kid doesn't have any goal. Every time I asked she said I don't know. 😭\",\n        \"createdAt\": \"2025-02-11T16:48:22.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"anncheev\",\n          \"displayName\": \"Lily_Pad🌱\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-maliva-avt-0068/7329130425770524678~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=6927a1ba&x-expires=1794067200&x-signature=4aLDGgh8RrzpCx%2FYqAzGjF1V%2B7o%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6813059560400831489\",\n          \"secUid\": \"MS4wLjABAAAAGXt1M3LLnYhINaXQqMEwkisQ8nYK7RA360m1eijQWcoblE0jSUqACtVi8Z7dLX7i\"\n        }\n      },\n      {\n        \"id\": \"7459582587163083562\",\n        \"text\": \"My daughter is a junior, but we are still waiting to hear from her top school about test optional?! I really need these schools to decide! 💀\",\n        \"createdAt\": \"2025-01-14T01:50:28.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"zoetallulah\",\n          \"displayName\": \"Lauren the Art Director\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-maliva-avt-0068/db24a681b9264db4ee7965bb4f4b4627~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=07a4561b&x-expires=1794067200&x-signature=zryVu64hAQYGB5iIrjHJzPeB8AI%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6654240876590514182\",\n          \"secUid\": \"MS4wLjABAAAAKmw4kTTxnQpO02iWua9dcP6ZRj6mqkHU_4f2KmzU358we7f-uSVAjZdRMKjL47kI\"\n        }\n      },\n      {\n        \"id\": \"7459567363416441630\",\n        \"text\": \"My junior is a b/B+ student in a very rigorous curriculum. National merit scholar, high sat score. Will he even be considered with a lower gpa that doesn’t match up! Tons of sports, volunteer, clubs e\",\n        \"createdAt\": \"2025-01-14T00:51:20.000Z\",\n        \"likes\": 3,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"ktedid\",\n          \"displayName\": \"user4733249947230\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/4ef6e50e41f43a2d8607dc5be8867f6f~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=385eb810&x-expires=1794067200&x-signature=vaXdR9w6t3W%2FWIzOOErPsGE6fdA%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6825984517028545542\",\n          \"secUid\": \"MS4wLjABAAAA49_-sGjaZr_t2ASklH4NaBjylVeM6tPl7EEA6yi-BIzQAlX38K-sqr0qh8QwCPYB\"\n        }\n      },\n      {\n        \"id\": \"7459558295087973150\",\n        \"text\": \"Love what you’re posting. This is so incredibly helpful. We have a sophomore who is going to be on this path very soon. Great stuff to consider and think about.\",\n        \"createdAt\": \"2025-01-14T00:16:09.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 4,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"remadexx\",\n          \"displayName\": \"Samantha Ford\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/7350846765857734698~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=4492f09c&x-expires=1794067200&x-signature=2KDXIsNefwwDA2crHzqXJfuAGm4%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7033504748632376325\",\n          \"secUid\": \"MS4wLjABAAAAdAac013EdUoGk_HuUCfRKfputibZamraHYAV-Hofa4NExrKuqxZjGrYDRlBldtDa\"\n        }\n      },\n      {\n        \"id\": \"7459536566206546719\",\n        \"text\": \"What about average grades/test scores. My son is smart, kind, active enough in school but his severe ADHD has stymied his success. I feel like he won’t be able to get in anywhere right now! He’s a jr\",\n        \"createdAt\": \"2025-01-13T22:51:49.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 13,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"bentonjones2\",\n          \"displayName\": \"Benton Jones\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/234440d93b81aa482d7c5b6c498fc77a~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=72769187&x-expires=1794067200&x-signature=NOqWsL0B%2F6dE07LvwU14lkBKnUM%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6804878489088754694\",\n          \"secUid\": \"MS4wLjABAAAA1BrYnlj1LzTTrhEaVoiLi1JK7AVm3W1z_Cf3OubACrsKHtBFDPOjaYNRE9gR7Ubl\"\n        }\n      },\n      {\n        \"id\": \"7459496225328448286\",\n        \"text\": \"My daughter applied RD so we have to wait til March 25 for the final decisions. Not sure about doing college visits because she has amazing stats but you never know. What should we do while she waits?\",\n        \"createdAt\": \"2025-01-13T20:15:26.000Z\",\n        \"likes\": 3,\n        \"replyCount\": 3,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"anonymous3.141592\",\n          \"displayName\": \"Lalala\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast8-avt-0068-tx2/8a8dea0441301a4181cfa1bd2df819ed~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=6b0c2b7b&x-expires=1794067200&x-signature=zPA0%2FoCKsR6UtHf3Gi%2B74528pdg%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"7079253824842875947\",\n          \"secUid\": \"MS4wLjABAAAALWhesM19L-6pChRB_cBRJ-IqSU201xUYfGacciMmdCJj87moijwOaPQjU5Q22gHZ\"\n        }\n      },\n      {\n        \"id\": \"7459485814738699054\",\n        \"text\": \"All 3 of mine graduated. Traveled the country for 2 of them to visit schools. It was fun to watch them go through it. I just paid and supported them.\",\n        \"createdAt\": \"2025-01-13T19:35:00.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"lasslor\",\n          \"displayName\": \"Lori\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/19a6aecb41337a35f783fda88548ea27~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=ada2a09c&x-expires=1794067200&x-signature=1qghwLDR%2FJggQFqWPDFs%2FrYZLQo%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6892429906069488646\",\n          \"secUid\": \"MS4wLjABAAAAZTQmlQUlzlY9vVeG6sSCqcE6GMuk3uThZa29FnwIy7qVJf2iB6Jny1uhg_d-OqmQ\"\n        }\n      },\n      {\n        \"id\": \"7538109046991569677\",\n        \"text\": \"🔥🔥🔥\",\n        \"createdAt\": \"2025-08-13T16:33:38.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 0,\n        \"language\": \"un\",\n        \"author\": {\n          \"handle\": \"terrycollier01\",\n          \"displayName\": \"Terrycollier01\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/59d69eb55c3bb2c670fae2ee866cb575~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=1c66c4b9&x-expires=1794067200&x-signature=srC4tB3g%2F1injuoTWVmMktUhpmg%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast5\",\n          \"platformUserId\": \"6777096166178948102\",\n    
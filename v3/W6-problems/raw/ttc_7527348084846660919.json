data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"7532578558795924254\",\n        \"text\": \"We paid. It wasn’t worth it. They did nothing at all. My son got recruited with help of his QB Coach.\",\n        \"createdAt\": \"2025-07-29T18:52:06.000Z\",\n        \"likes\": 42,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"kimsb1969\",\n          \"displayName\": \"Kim\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/5154705193a79b3f006ecc34017ee139~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=9c89fbf7&x-expires=1794067200&x-signature=Zz7Yneb78FDKwswA%2BdjE30z2rkE%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"6813135341592478725\",\n          \"secUid\": \"MS4wLjABAAAAY26VlAOOXlGncQ4H0qiBTztLoFjMeA-7dItZJKuroRKQpeuHeiXTZQ5Y-a06RS7P\"\n        }\n      },\n      {\n        \"id\": \"7527654213934400286\",\n        \"text\": \"I would encourage parents to talk to other parents that paid to see if it’s worth it. We did not pay.\",\n        \"createdAt\": \"2025-07-16T12:23:47.000Z\",\n        \"likes\": 25,\n        \"replyCount\": 6,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"cruz_missile25\",\n          \"displayName\": \"Cruz Bañuelas Catcher\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/7350197488009084974~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=1742cadc&x-expires=1794067200&x-signature=xHoIrF4gtqF6dCK9QnyMDKiFHVw%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"7174026838708372526\",\n          \"secUid\": \"MS4wLjABAAAA3qB-9NNeVuajX2VL5Xyk71BaeencfPZXfFMqtzgp8kQlunmBSFxWYBrTEQgr7mOd\"\n        }\n      },\n      {\n        \"id\": \"7539916329575334687\",\n        \"text\": \"Thank you so much. I ask after the call. I told him needed time to think about it. He got aggressive. I’m just trying to help my son.\",\n        \"createdAt\": \"2025-08-18T13:26:29.000Z\",\n        \"likes\": 9,\n        \"replyCount\": 2,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"diinr20\",\n          \"displayName\": \"DIINR20\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/musically-maliva-obj/1594805258216454~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=c043984f&x-expires=1794067200&x-signature=N6aGIRwjGaTIxlykkM%2FXo5BweKM%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"7122301647804220462\",\n          \"secUid\": \"MS4wLjABAAAAfm93JG7Dn7WHFKbvZ-yVJKkkdEzyxFkLo2ej0DaNC4Q6DLF1malWNmrEFcnOQWrx\"\n        }\n      },\n      {\n        \"id\": \"7527417423805694751\",\n        \"text\": \"These guys kept calling me before we went to the University of Oregon camp, trying to “Leverage” our visit for a price I’m sure. My son and I did our own work and introduced ourselves to the coaches and gathered all their contact information. Even got a selfie with Head Coach Dan Lanning\",\n        \"createdAt\": \"2025-07-15T21:04:21.000Z\",\n        \"likes\": 8,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"dstrong797\",\n          \"displayName\": \"dstrong797\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/7350081539318743086~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=c7e79c6c&x-expires=1794067200&x-signature=tHHNGo72grmYziG86G0dl91%2FyMk%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"6817656947450463238\",\n          \"secUid\": \"MS4wLjABAAAAJqinLn_Es7LkiVUkNnqwOneF4mt4ghlPtQ8C3slHZHru0F-ehrgr5FR3-uyU4t29\"\n        }\n      },\n      {\n        \"id\": \"7704542405998936845\",\n        \"text\": \"what is another free program or website to update information to get recruited for volleyball\",\n        \"createdAt\": \"2026-11-05T04:39:54.000Z\",\n        \"likes\": 0,\n        \"replyCount\": 0,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"mmmaritza92\",\n          \"displayName\": \"Maritza\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/1ec320cb3a2576c76a4168fa6c60e541~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=0e7e1fbe&x-expires=1794067200&x-signature=9NdV8vjqL9YSpUuGGGPuO5InDzM%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"7291840152602149931\",\n          \"secUid\": \"MS4wLjABAAAAxj9vyFjG2Fa-lM3Z7uj_4LqWqwAHoWtmmKOwr2zJcj3W3n03nqIe7qjFHqn-GIYq\"\n        }\n      },\n      {\n        \"id\": \"7694964861428695822\",\n        \"text\": \"\",\n        \"createdAt\": \"2026-10-10T09:17:20.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 0,\n        \"language\": \"un\",\n        \"author\": {\n          \"handle\": \"daddy.ball35\",\n          \"displayName\": \"❌DaddyBall🇺🇸\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/c3408a4c7c0048685acf83cfda5d939f~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=6348d6c3&x-expires=1794067200&x-signature=z2ZxlUGH58O2u6Wa7yTetcHNQig%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"7381543789565985838\",\n          \"secUid\": \"MS4wLjABAAAAWRQteUWHHpkBKvUa9LZpyF8K0lkUXJZoCisbDgIDh8s2BIiXm7tvdmr-9ahk7DyV\"\n        }\n      },\n      {\n        \"id\": \"7683540353488290574\",\n        \"text\": \"Just got a call came on TikTok to find info and found you,everything u said is exactly how it happened,\\nthank you and all the comments 😊\",\n        \"createdAt\": \"2026-09-09T14:21:49.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"elizabethponrey\",\n          \"displayName\": \"Elizabeth Ponce\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-maliva-avt-0068/722ffa1936a353968da03ce8fe4c3df4~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=fac9746b&x-expires=1794067200&x-signature=1OVCk0eQ3BdgAxExtsTY8V0IVE4%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"6862885799193478150\",\n          \"secUid\": \"MS4wLjABAAAAAp3Lr9C-0H960lSeo5EfCQmft9m_g-uytxGznzZUVdHtXdOVEc4uyd37E1sHCLoC\"\n        }\n      },\n      {\n        \"id\": \"7666179456595608333\",\n        \"text\": \"Darn just signed up and paid 😭\",\n        \"createdAt\": \"2026-07-24T19:32:14.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 0,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"arakoehler\",\n          \"displayName\": \"arakoehler\",\n          \"avatarUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/de64f4ad0590ba98de576d5b561990ec~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=3f0329e4&x-expires=1794067200&x-signature=eFCpZ3mw7bcKuhAis%2BvIpKlXOlo%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"294351816329330688\",\n          \"secUid\": \"MS4wLjABAAAAiXgBfjFr7Kzi1s9spNDrp8LhZQT5Um0l2tRFYmaa0AXilcGBew8F4JeF0q2cFAGj\"\n        }\n      },\n      {\n        \"id\": \"7664358052493443870\",\n        \"text\": \"does a free profile with NCSA get noticed by colleges and coaches?\",\n        \"createdAt\": \"2026-07-19T21:44:06.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 1,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"anastasia.dessaint\",\n          \"displayName\": \"Anastasia Golovina Dessaint\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/2d6014b49e1ee41284e4396e44d3a139~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=51a5a816&x-expires=1794067200&x-signature=Sm60mFrpwdn0HZFnEfWMbPsTq1w%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"7075122171329283115\",\n          \"secUid\": \"MS4wLjABAAAAFpAdKe1Fie4g2BdLce8DQW-pgZ_aF006qQBGlo-0Vq3rTgCjvoamBIttmdjQ2Lu6\"\n        }\n      },\n      {\n        \"id\": \"7634966481726161678\",\n        \"text\": \"What if my son was invited to a NCSA soccer camp? Is it even worth going?\",\n        \"createdAt\": \"2026-05-01T16:50:02.000Z\",\n        \"likes\": 2,\n        \"replyCount\": 0,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"taniacisnerosdeastorga\",\n          \"displayName\": \"Mama T\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-maliva-avt-0068/7332654974633164805~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=b17ec2d3&x-expires=1794067200&x-signature=UG0uf2XqrOY9eAeLwoJEnwbCZ0w%3D&t=4d5b0474&ps=13740610&shp=30310797&shcp=ff37627b&idc=useast8\",\n          \"platformUserId\": \"6732456247008691205\",\n          \"secUid\": \"MS4wLjABAAAAcRNva6HVN3tuqqmB1W089rrYhfJ0k7xngHnGNs3wAHg6vy-JPXz-EJLK8RwgcwX_\"\n        }\n      },\n      {\n        \"id\": \"7612883462937314062\",\n        \"text\": \"We just got off a call with the. Didn't go through with it. They definitely tried to get our 8th grade son involved so that he could try to convince us.\",\n        \"createdAt\": \"2026-03-03T04:36:48.000Z\",\n        \"likes\": 1,\n        \"replyCount\": 0,\n        \"language\": \"en\",\n        \"author\": {\n          \"handle\": \"meli.mom.nurse\",\n          \"displayName\": \"✨️Melissa✨️\",\n          \"avatarUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-avt-0068-tx/6d6dbffb605f5b396559a5f069c694b4~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_to
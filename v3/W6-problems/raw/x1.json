0\n          },\n          {\n            \"url\": \"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/720x1280/cwoiXukY59kbdZck.mp4?tag=21\",\n            \"type\": \"video\",\n            \"thumbnailUrl\": \"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg\",\n            \"contentType\": \"video/mp4\",\n            \"bitrate\": 2176000,\n            \"width\": 2160,\n            \"height\": 3840,\n            \"id\": \"1990458409741586432\",\n            \"altText\": null,\n            \"durationMs\": 39750\n          },\n          {\n            \"url\": \"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/1080x1920/fW6ZrCYXmwZNczQj.mp4?tag=21\",\n            \"type\": \"video\",\n            \"thumbnailUrl\": \"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg\",\n            \"contentType\": \"video/mp4\",\n            \"bitrate\": 10368000,\n            \"width\": 2160,\n            \"height\": 3840,\n            \"id\": \"1990458409741586432\",\n            \"altText\": null,\n            \"durationMs\": 39750\n          },\n          {\n            \"url\": \"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/2160x3840/Qz8lpFcT70gxG4iI.mp4?tag=21\",\n            \"type\": \"video\",\n            \"thumbnailUrl\": \"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg\",\n            \"contentType\": \"video/mp4\",\n            \"bitrate\": 25128000,\n            \"width\": 2160,\n            \"height\": 3840,\n            \"id\": \"1990458409741586432\",\n            \"altText\": null,\n            \"durationMs\": 39750\n          }\n        ],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"2118516001117762039\",\n        \"url\": \"https://x.com/rekrut_app/status/2118516001117762039\",\n        \"text\": \"I used to charge families $3,000 to help with recruiting.\\n\\nToo many kids missed their chance because of the price, not their talent.\\n\\nWhat I learned: coaches want to hear from the athlete, not from a middleman.\\n\\nSo I built a platform, not a service. Part 1 of 6. https://x.com/rekrut_app/status/2118516001117762039/video/1\",\n        \"createdAt\": \"2026-11-06T01:29:09.000Z\",\n        \"createdAtUnix\": 1793928549,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"2118516001117762039\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"rekrut_app\",\n          \"displayName\": \"Rekrut | College Recruiting\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2112014794052026368/C8DFmHSQ_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/rekrut_app\",\n          \"verified\": false,\n          \"blueVerified\": false,\n          \"platformUserId\": \"4607974219\",\n          \"bio\": \"Smart college recruiting. Get matched to schools that actually fit, not pipe dreams. Coach interviews and recruiting truth weekly. Free profile below.\",\n          \"location\": \"Arizona, USA\",\n          \"website\": \"https://rekrut.app/register\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/4607974219/1783960851/1500x500\",\n          \"accountCreatedAt\": \"2015-12-20T01:10:19.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": null,\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 4648,\n            \"following\": 3061,\n            \"tweets\": 3781,\n            \"favourites\": 2769,\n            \"listedCount\": 9,\n            \"mediaCount\": 2648\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 3,\n          \"retweets\": 1,\n          \"replies\": 0,\n          \"quotes\": 0,\n          \"views\": 73,\n          \"bookmarkCount\": 0\n        },\n        \"media\": [\n          {\n            \"url\": \"https://video.twimg.com/amplify_video/2118515957006204928/vid/avc1/320x568/AgYYGDl6pzLWHQuh.mp4?tag=29\",\n            \"type\": \"video\",\n            \"thumbnailUrl\": \"https://pbs.twimg.com/amplify_video_thumb/2118515957006204928/img/HUaaH7eSy6LApD7l.jpg\",\n            \"contentType\": \"video/mp4\",\n            \"bitrate\": 632000,\n            \"width\": 720,\n            \"height\": 1280,\n            \"id\": \"2118515957006204928\",\n            \"altText\": null,\n            \"durationMs\": 42056\n          },\n          {\n            \"url\": \"https://video.twimg.com/amplify_video/2118515957006204928/vid/avc1/480x852/n0HICOmBH_wulp_L.mp4?tag=29\",\n            \"type\": \"video\",\n            \"thumbnailUrl\": \"https://pbs.twimg.com/amplify_video_thumb/2118515957006204928/img/HUaaH7eSy6LApD7l.jpg\",\n            \"contentType\": \"video/mp4\",\n            \"bitrate\": 950000,\n            \"width\": 720,\n            \"height\": 1280,\n            \"id\": \"2118515957006204928\",\n            \"altText\": null,\n            \"durationMs\": 42056\n          },\n          {\n            \"url\": \"https://video.twimg.com/amplify_video/2118515957006204928/vid/avc1/720x1280/QOcTXiJglKXAgpBS.mp4?tag=29\",\n            \"type\": \"video\",\n            \"thumbnailUrl\": \"https://pbs.twimg.com/amplify_video_thumb/2118515957006204928/img/HUaaH7eSy6LApD7l.jpg\",\n            \"contentType\": \"video/mp4\",\n            \"bitrate\": 2176000,\n            \"width\": 720,\n            \"height\": 1280,\n            \"id\": \"2118515957006204928\",\n            \"altText\": null,\n            \"durationMs\": 42056\n          }\n        ],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"2061593301216567296\",\n        \"url\": \"https://x.com/TweetsbyCoachP/status/2061593301216567296\",\n        \"text\": \"One of the reasons youth sports has become so complicated is because everyone involved is often chasing a different definition of success.\\n\\nOne parent wants college recruiting to be the primary focus. Another wants their child to enjoy the experience and make friends. Another wants championships. Another wants equal playing time. Another believes development matters more than wins. Another believes if you’re paying thousands of dollars, your child should be on the field or court.\\n\\nNone of those perspectives are necessarily or inherently wrong. They’re just different.\\n\\nThe challenge is that one coach, one team, and one season cannot satisfy all of them at the same time.\\n\\nParents are also navigating an increasingly confusing landscape. Travel teams, private trainers, recruiting services, showcases, camps, social media influencers, former players, college coaches, and other parents all offer advice. Often that advice directly contradicts itself.\\n\\nOne person says play multiple sports. Another says specialize early.\\n\\nOne person says development matters most. Another says exposure matters most.\\n\\nOne person says find the best coach. Another says find the team that will give your child the most playing time.\\n\\nOne person says your child needs more reps. Another says your child needs more rest.\\n\\nOne person says the child should attend prom and not miss life events. Another says team commitments should come before all else. \\n\\nFor families investing significant amounts of time and money, it can become incredibly difficult to know who to trust.\\n\\nThe coaching side is just as complicated.\\n\\nMost coaches are not showing up every day trying to hold players back, target families, or play favorites. Most genuinely care about their athletes and want them to succeed. But coaches are often forced to make decisions where there are no perfect answers.\\n\\nShould they prioritize winning or development?\\n\\nShould they play the senior who has earned it or the younger player with a higher ceiling?\\n\\nShould they focus on the best interests of one athlete or the best interests of the team?\\n\\nShould they reward effort, production, leadership, potential, experience, or loyalty?\\n\\nEvery decision creates a winner and a loser in someone’s eyes.\\n\\nA coach sees the entire roster. A parent sees their child.\\n\\nNeither perspective is inherently wrong, but they naturally create conflict.\\n\\nThe reality is that parents often judge a season through the lens of their child’s experience, while coaches are forced to evaluate it through the lens of the entire team. Those viewpoints frequently collide.\\n\\nAdd in the emotional investment, financial commitment, social media comparisons, recruiting pressure, and the fact that every child develops at a different pace, and it becomes easy to see why frustration exists.\\n\\nYouth sports isn’t difficult because people don’t care.\\n\\nIt’s difficult because everyone cares deeply.\\n\\nParents care about their children.\\n\\nCoaches care about their teams.\\n\\nAthletes care about their opportunities.\\n\\nAnd when passionate people are pursuing different goals, disagreements are inevitable.\\n\\nThe best environments aren’t the ones where everyone always agrees. They’re the ones where expectations are clear, communication is honest, trust is built over time, and everyone remembers that there are many different paths to success in sports and in life.\",\n        \"createdAt\": \"2026-06-01T23:38:40.000Z\",\n        \"createdAtUnix\": 1780357120,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"2061593301216567296\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"TweetsbyCoachP\",\n          \"displayName\": \"William Payne\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2108037448278450176/xNRFLgTH_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/TweetsbyCoachP\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"2542103608\",\n          \"bio\": \"Systemwide Director of Athletics @ Pinecrest Academies of Nevada •🏆 Winning Small College 🏀 Coach • Recruiting • Small College/HBCU Advocate • 📚📕📗📘📙\",\n          \"location\": \"Henderson, NV\",\n          \"website\": \"https://www.pinecrestnv.org/\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/2542103608/1787777405/1500x500\",\n          \"accountCreatedAt\": \"2014-05-12T00:43:06.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": {\n            \"type\": \"Creator\",\n            \"category\": [\n              {\n                \"id\": 800,\n                \"name\": \"Sports, Fitness & Recreation\",\n                \"icon_name\": \"IconBriefcaseStroke\"\n              }\n            ],\n            \"restId\": \"1471870317882654720\"\n          },\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 115986,\n            \"following\": 4599,\n            \"tweets\": 80052,\n            \"favourites\": 143639,\n            \"listedCount\": 108,\n            \"mediaCount\": 5203\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 154,\n          \"retweets\": 37,\n          \"replies\": 12,\n          \"quotes\": 5,\n          \"views\": 21414,\n          \"bookmarkCount\": 65\n        },\n        \"media\": [],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": \"Twitter for iPhone\",\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"2117285609765286075\",\n        \"url\": \"https://x.com/CSAPrepStar/status/2117285609765286075\",\n        \"text\": \"PARENTS, IS YOUR ATHLETE READY TO GET ON COLLEGE COACHES’ RADAR?\\n\\nCollege recruiting takes more than talent. Athletes need strong academics, an updated recruiting profile, quality highlight footage, and a proactive approach to connecting with college programs.\\n\\nThat’s where we can help! We help student-athletes showcase their athletic and academic achievements and take proactive steps toward their college recruiting journey.\\n\\n📌 SAVE this post for future reference.\\n📲 SHARE it with a sports parent who needs to see this.\\n💬 COMMENT: What’s your biggest question about college recruiting?\\n\\nReady to get started? Create your athlete profile today! Link in bio.\\n\\n@prepstar360\",\n        \"createdAt\": \"2026-11-02T16:00:01.000Z\",\n        \"createdAtUnix\": 1793635201,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"2117285609765286075\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"q
942951902035066880"}],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2013769108253298877","url":"https://x.com/TweetsbyCoachP/status/2013769108253298877","text":"Players and Parents: Critical piece of recruiting advice from a current Athletic Director, former college basketball coach, and parent of 4 that played or participated in college….\n\nAsk this crucial question…..”would I attend that school if athletics weren’t involved at all?”","createdAt":"2026-01-21T00:22:24.000Z","createdAtUnix":1768954944,"createdAtLabel":null,"language":"en","conversationId":"2013769108253298877","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"TweetsbyCoachP","displayName":"William Payne","avatarUrl":"https://pbs.twimg.com/profile_images/2108037448278450176/xNRFLgTH_400x400.jpg","profileUrl":"https://x.com/TweetsbyCoachP","verified":false,"blueVerified":true,"platformUserId":"2542103608","bio":"Systemwide Director of Athletics @ Pinecrest Academies of Nevada •🏆 Winning Small College 🏀 Coach • Recruiting • Small College/HBCU Advocate • 📚📕📗📘📙","location":"Henderson, NV","website":"https://www.pinecrestnv.org/","bannerUrl":"https://pbs.twimg.com/profile_banners/2542103608/1787777405/1500x500","accountCreatedAt":"2014-05-12T00:43:06.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Creator","category":[{"id":800,"name":"Sports, Fitness & Recreation","icon_name":"IconBriefcaseStroke"}],"restId":"1471870317882654720"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":115986,"following":4599,"tweets":80052,"favourites":143639,"listedCount":108,"mediaCount":5203}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":32,"retweets":5,"replies":2,"quotes":0,"views":4145,"bookmarkCount":1},"media":[],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":"Twitter for iPhone","communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2056768415604355330","url":"https://x.com/coach_Mollring/status/2056768415604355330","text":"20 years coaching college football. \n5 as a head coach. \n7 years using and then training college coaches on how to recruit at Tudor Collegiate Strategies.\nI wrote the book on what winning actually looks like inside a program — and I use the same playbook with the families I work with.\nIf you're a player or parent trying to figure out recruiting, you're not getting generic advice from me. \nYou're getting the exact framework I taught the coaches who are recruiting you.\n📘 Book: https://a.co/d/02je4ENm\n 🎯 Work with me: http://nomoathletics.com","createdAt":"2026-05-19T16:06:17.000Z","createdAtUnix":1779206777,"createdAtLabel":null,"language":"en","conversationId":"2056768415604355330","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"coach_Mollring","displayName":"Grant Mollring","avatarUrl":"https://pbs.twimg.com/profile_images/2052202930225254406/7_IhQ3Mu_400x400.jpg","profileUrl":"https://x.com/coach_Mollring","verified":false,"blueVerified":false,"platformUserId":"3195417666","bio":"Former D3 Head Coach & recruiting educator. I know what coaches want — now I help families navigate the process. 🏈 NoMo Athletics | Recruit Accelerator","location":"Lincoln, NE","website":"http://Nomoathletics.com","bannerUrl":"https://pbs.twimg.com/profile_banners/3195417666/1778118282/1500x500","accountCreatedAt":"2015-05-14T15:48:50.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Business","category":[{"id":800,"name":"Sports, Fitness & Recreation","icon_name":"IconBriefcaseStroke"}],"restId":"2038665470681727379"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":4337,"following":3553,"tweets":1822,"favourites":4411,"listedCount":24,"mediaCount":197}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":6,"retweets":2,"replies":4,"quotes":0,"views":1190,"bookmarkCount":0},"media":[],"expandedUrl":"https://a.co/d/02je4ENm","isRetweet":false,"isReply":false,"isQuote":false,"source":"Twitter Web App","communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[{"url":"https://a.co/d/02je4ENm","displayUrl":"https://a.co/d/02je4ENm","expandedUrl":"https://a.co/d/02je4ENm"},{"url":"http://nomoathletics.com","displayUrl":"http://nomoathletics.com","expandedUrl":"http://nomoathletics.com"}],"symbols":[]},"card":{"type":"summary","name":"summary_large_image","url":"https://t.co/5w9xMCGDyr","title":"What Winning Actually Looks LIke","description":"Inside this book, you’ll learn: This book is for: What makes this different? If you’re serious about building a program…","domain":"www.amazon.com","imageUrl":"https://pbs.twimg.com/card_img/2118121137221906432/L2BNYhTc?format=jpg&name=orig","playerUrl":null,"appName":null},"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2117312457329070575","url":"https://x.com/coachdrew94/status/2117312457329070575","text":"This morning a father of a '27 player in my program called upset. His son has only heard from D3 and some D2 coaches. He wants D1.\n\nHere's what I tried to explain:\n\n• His son is a corner outfielder. It's the LAST position college coaches recruit for.\n• At the D1 level, coaches over-recruit shortstops and move them to the outfield.\n• Many D1 coaches wait for the transfer portal in December to see what outfielders are available before they commit a roster spot to a high school kid.\n\nHe hung up on me.\n\nParents, D2 and D3 interest is not a failure. It's real interest from coaches who want your son. Position matters. Timing matters. Know the landscape.\n\nCoach Drew","createdAt":"2026-11-02T17:46:42.000Z","createdAtUnix":1793641602,"createdAtLabel":null,"language":"en","conversationId":"2117312457329070575","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"coachdrew94","displayName":"Coach Drew's Recruiting Service - 27 yrs. exp.","avatarUrl":"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg","profileUrl":"https://x.com/coachdrew94","verified":false,"blueVerified":true,"platformUserId":"1667193117597143040","bio":"If you're a 27' player with 0 offers, still looking, not ready to give up, I can help you find offers. https://t.co/KBP0klXNsL","location":"Serving families nationwide","website":"https://coachdrew93.com/","bannerUrl":"https://pbs.twimg.com/profile_banners/1667193117597143040/1793728987/1500x500","accountCreatedAt":"2023-06-09T15:33:27.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":null,"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":16335,"following":7408,"tweets":4435,"favourites":15,"listedCount":5,"mediaCount":146}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":729,"retweets":11,"replies":44,"quotes":2,"views":143447,"bookmarkCount":20},"media":[],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2116116868867952797","url":"https://x.com/SFACoachMartin/status/2116116868867952797","text":"RECRUITING TALK: STARS, NO STARS & NIL 🏈\n\nAs a high school coach, I want players and parents to understand this: recruiting stars can help open doors, but they don’t determine how far you can go.\n\nRespect the players who earned those ratings. Many are outstanding athletes who put in serious work. But understand what a star rating represents: a recruiting service’s evaluation and projection at a particular point in a player’s development.\n\nIt is not a scholarship, a starting position, a degree or a guaranteed NFL career.\n\nAnd being unrated does NOT mean a college coaching staff cannot evaluate you, recruit you or offer you a scholarship.\n\nSome players develop later. Some receive less exposure. Some haven’t been evaluated extensively. Others need to improve before they’re ready for the next level. Our job as coaches is to give an honest assessment and help each player build a realistic path.\n\nCollege coaches recruit for THEIR roster. Your film, verified measurables, academics, position fit, development and character all matter. A recruiting website doesn’t make their final decision.\n\nWant proof that an unrated player can build a professional career? Josh Allen left high school without stars, went through junior college and earned his opportunity at Wyoming. His path proves it is possible—not that it is easy or guaranteed.\n\nNow let’s address NIL.\n\nThere is no recruiting-star requirement for a legitimate NIL opportunity.\n\nNIL means a business compensates you for using your name, image or likeness through activities such as endorsements, promotional content or appearances. Stars may increase visibility, but businesses can also value your audience, community connections, credibility and ability to represent their brand.\n\nAn unrated player with an engaged local following and professional habits can offer value to a business. That does not guarantee a deal, and every athlete should have realistic expectations about the money involved.\n\nStart building those habits now:\n\n• Put quality football on film.\n• Protect your grades and eligibility.\n• Make your recruiting information easy to find.\n• Communicate professionally.\n• Build authentic community relationships.\n• Create useful, consistent content.\n• Follow through when you make a commitment.\n\nUnderstand this distinction, too: a scholarship, third-party NIL deal and direct payment from a college are different things. An offer does not automatically include all three.\n\nBefore accepting NIL compensation, verify the rules that apply to your school, athletic association and future college. Have agreements reviewed and meet applicable reporting requirements.\n\nMy advice: choose a college where you can develop, afford your education and prepare for life. Evaluate the coaching, academics, roster and total financial package.\n\nFootball can lead to college, professional opportunities, coaching, business and relationships that last well beyond your playing days. The NFL is one possible outcome—not the only meaningful career.\n\nRated players: keep earning it.\nUnrated players: keep developing and getting evaluated.\n\nYour rating can describe where you are today. It cannot finish your story.\nYou’re welcome.\n#sfaacadenyfootball \n#FootballRecruiting #RecruitingEducation #StudentAthlete #NIL #HighSchoolFootball\n#9091sportsagency","createdAt":"2026-10-30T10:35:51.000Z","createdAtUnix":1793356551,"createdAtLabel":null,"language":"en","conversationId":"2116116868867952797","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"SFACoachMartin","displayName":"Coach Martin","avatarUrl":"https://pbs.twimg.com/profile_images/2033611255244533760/3e04yxjb_400x400.jpg","profileUrl":"https://x.com/SFACoachMartin","verified":false,"blueVerified":true,"platformUserId":"1594759961170558979","bio":"Safeties Coach/Recruiting Coordinator @ SFA \nhttps://t.co/PI7roM7Kfr\nhttps://t.co/GUYw4VdQBh\nFounder:https://t.co/7wuS7qy6Dk","location":"Tampa, Florida","website":"http://strongfaithathletics.com","bannerUrl":"https://pbs.twimg.com/profile_banners/1594759961170558979/1673077270/1500x500","accountCreatedAt":"2022-11-21T18:30:00.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Business","category":[{"id":800,"name":"Sports, Fitness & Recreation","icon_name":"IconBriefcaseStroke"}],"restId":"1648018533152874496"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":3013,"following":5323,"tweets":2303,"favourites":3026,"listedCount":4,"mediaCount":986}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":21,"retweets":4,"replies":0,"quotes":0,"views":2358,"bookmarkCount":3},"media":[],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[{"text":"sfaacadenyfootball"},{"text":"FootballRecruiting"},{"text":"RecruitingEducation"},{"text":"StudentAthlete"},{"text":"NIL"},{"text":"HighSchoolFootball"},{"text":"9091sportsagency"}],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2118733820728082922","url":"https://x.com/coachdrew94/status/2118733820728082922","text":"Hey! Quick favor.\n\nDo you know a teammate or friend who can play in college but is still looking, or is ready to give up because he has no offers?\n\nI'd love to help him. Phase 2 is when most families stop, and it's when I find players their opportunities.\n\nHave him or his parents go to my site and complete the evaluation and scholarship application:\nhttps://coachdrew93.com/\n\nThanks for thinking of me. It means a lot.\n\nCoach Drew","createdAt":"2026-11-06T15:54:41.000Z","createdAtUnix":1793980481,"createdAtLabel":null,"language":"en","conversationId":"2118733820728082922","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"coachdrew94","displayName":"Coach Drew's Recruiting Service - 27 yrs. exp.","avatarUrl":"https://pbs.twimg.com/profile_images/2117681283660996608/wjkYgCjw_400x400.jpg","profileUrl":"https://x.com/coachdrew94","verified":false,"blueVerified":true,"platformUserId":"1667193117597143040","bio":"If you're a 27' player with 0 offers, still looking, not ready to give up, I can help you find offers. https://t.co/KBP0klXNsL","location":"Serving families nationwide","website":"https://coachdrew93.com/","bannerUrl":"https://pbs.twimg.com/profile_banners/1667193117597143040/1793728987/1500x500","accountCreatedAt":"2023-06-09T15:33:27.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":null,"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":16335,"following":7408,"tweets":4435,"favourites":15,"listedCount":5,"mediaCount":146}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":0,"retweets":0,"replies":0,"quotes":0,"views":98,"bookmarkCount":0},"media":[],"expandedUrl":"https://coachdrew93.com/","isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[{"url":"https://coachdrew93.com/","displayUrl":"https://coachdrew93.com/","expandedUrl":"https://coachdrew93.com/"}],"symbols":[]},"card":{"type":"summary","name":"summary","url":"https://t.co/xxqtBnTfbp","title":"Coach Drew | College Recruiting · 27 Years · 4,413+ Players Placed","description":"Coach Drew Sikorski: 27+ years working with college coaches and 4,413+ players placed at D1, D2, D3, NAIA and JUCO. CDRI Evaluation $79.95, Phase 2 recruiting and the Private Program.","domain":"coachdrew93.com","imageUrl":null,"playerUrl":null,"appName":null},"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2118410522093613557","url":"https://x.com/The_CAAdvantage/status/2118410522093613557","text":"One of the most frustrating parts of the recruiting process is when you reach out to college coaches and hear absolutely NOTHING back. 👎🏼\n\nYou start wondering \"What am I doing wrong?!\" 😩\n\nThe reality is that a lack of responses from college coaches doesn’t necessarily mean you/your athlete can’t play in college, but it DOES mean you need to take a closer look at your recruiting strategy. 🔍\n\nCollege coaches receive hundreds of emails, so they filter through prospects quickly. If they can’t evaluate you quickly, they may move on....\n\nSo what can you do about it? 👇\n\n1️⃣ Evaluate the schools you’re contacting. If you are reaching out to programs above your ability level, you won’t receive many responses.\n\n2️⃣ Second, evaluate your message. Your emails should make key information easily accessible, including graduation year, key metrics/stats, video links, and academic information.\n\n3️⃣ Third, follow up with a purpose. Send meaningful updates when you improves, achieve something significant, or have new video available.\n\nBottom Line 👉 Don’t interpret silence as a final verdict on your athlete’s ability, but don’t ignore it either. If you’re contacting dozens of coaches and getting very few responses, something probably needs to change.\n\nAnd if your family is frustrated by a lack of communication from college coaches and you're unsure what to do differently, message us and ask to schedule a free recruiting consultation. 💪","createdAt":"2026-11-05T18:30:01.000Z","createdAtUnix":1793903401,"createdAtLabel":null,"language":"en","conversationId":"2118410522093613557","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"The_CAAdvantage","displayName":"College Athlete Advantage","avatarUrl":"https://pbs.twimg.com/profile_images/1820939234616004608/7zXRV1lz_400x400.jpg","profileUrl":"https://x.com/The_CAAdvantage","verified":false,"blueVerified":true,"platformUserId":"1023658809565179906","bio":"A group of former college coaches and players that help advise student athletes in today's baseball recruiting world.","location":"Tempe, AZ","website":"http://collegeathleteadvantage.com","bannerUrl":"https://pbs.twimg.com/profile_banners/1023658809565179906/1769970062/1500x500","accountCreatedAt":"2018-07-29T19:57:33.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Business","category":[{"id":800,"name":"Sports, Fitness & Recreation","icon_name":"IconBriefcaseStroke"}],"restId":"1470022764295692288"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":9348,"following":4052,"tweets":6558,"favourites":4537,"listedCount":8,"mediaCount":4265}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":0,"retweets":0,"replies":0,"quotes":0,"views":162,"bookmarkCount":0},"media":[{"url":"https://pbs.twimg.com/media/HWYbJGYXwAEUyXn.jpg","type":"photo","width":1080,"he
UserId":"1021745572036927488"},{"handle":"coachschoiceusa","displayName":"COACH'S CHOICE USA","platformUserId":"956542536"}],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2117738960784912856","url":"https://x.com/diamondconnbsb/status/2117738960784912856","text":"Recruiting has two jobs:\n\nParent: proofread, organize the school list, handle logistics, ask the money and academic questions on visits.\n\nPlayer: write, send, and talk with coaches.\n\nCoaches want to know they're recruiting the player, not the parent. https://x.com/diamondconnbsb/status/2117738960784912856/photo/1","createdAt":"2026-11-03T22:01:28.000Z","createdAtUnix":1793743288,"createdAtLabel":null,"language":"en","conversationId":"2117738960784912856","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"diamondconnbsb","displayName":"Diamond Connect Baseball","avatarUrl":"https://pbs.twimg.com/profile_images/2109034077382729728/9tVZLScQ_400x400.jpg","profileUrl":"https://x.com/diamondconnbsb","verified":false,"blueVerified":true,"platformUserId":"1744778001680609280","bio":"Development + recruiting — HS baseball families / Coach Cory · HS, academy, travel / Train them. Help them get seen. / First 10 families: Level 1 $99 👇","location":"West Palm Beach, FL","website":"http://diamondconnectbaseball.com","bannerUrl":"https://pbs.twimg.com/profile_banners/1744778001680609280/1728585724/1500x500","accountCreatedAt":"2024-01-09T17:47:59.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":null,"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":118,"following":787,"tweets":126,"favourites":15,"listedCount":0,"mediaCount":50}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":1,"retweets":0,"replies":0,"quotes":0,"views":42,"bookmarkCount":0},"media":[{"url":"https://pbs.twimg.com/media/HWO4XKQXsAAp82C.jpg","type":"photo","width":1600,"height":900,"id":"2117738957823782912","altText":"Graphic titled Recruiting has two jobs. Parent: proofread, organize the list, handle logistics, ask the money and academic questions. Player: write the emails, send them himself, talk with coaches. Coaches want to recruit the player, not the parent."}],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2016181873693610216","url":"https://x.com/FiredCoaches/status/2016181873693610216","text":"http://x.com/i/article/2016168849503043584","createdAt":"2026-01-27T16:09:52.000Z","createdAtUnix":1769530192,"createdAtLabel":null,"language":"zxx","conversationId":"2016181873693610216","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"FiredCoaches","displayName":"Fired Coaches of Georgia","avatarUrl":"https://pbs.twimg.com/profile_images/2051366630957993984/AM9uHmcd_400x400.jpg","profileUrl":"https://x.com/FiredCoaches","verified":false,"blueVerified":true,"platformUserId":"1956526425244119040","bio":"The Unofficial Coaches Office of HS Football 🏈 | Commentary + Breaking News + Satire | Can’t tell satire from truth? That’s on you.","location":"Georgia, USA","website":"https://firedcoaches.org","bannerUrl":"https://pbs.twimg.com/profile_banners/1956526425244119040/1787000270/1500x500","accountCreatedAt":"2025-08-16T01:20:38.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Creator","category":[{"id":933,"name":"Media Personality","icon_name":"IconBriefcaseStroke"}],"restId":"1997505815822102819"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":9986,"following":717,"tweets":3648,"favourites":7414,"listedCount":6,"mediaCount":1102}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":97,"retweets":40,"replies":5,"quotes":13,"views":44112,"bookmarkCount":12},"media":[],"expandedUrl":"http://x.com/i/article/2016168849503043584","isRetweet":false,"isReply":false,"isQuote":false,"source":"Twitter Web App","communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[{"url":"http://x.com/i/article/2016168849503043584","displayUrl":"http://x.com/i/article/2016168849503043584","expandedUrl":"http://x.com/i/article/2016168849503043584"}],"symbols":[]},"card":null,"poll":null,"article":{"title":"PSA for Parents","previewText":"We've all heard the saying: \"If something seems too good to be true, it probably is.\"  Or, \"No such thing as a free lunch\". You've likely said it to your own kid at some point. So why does it fall on","id":"2016168849503043584","text":null,"coverImageUrl":"https://pbs.twimg.com/media/G_rqAs2W8AASxQh.jpg"},"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2117966635403223278","url":"https://x.com/CoachDaniels06/status/2117966635403223278","text":"🔑 RECRUITING TIP OF THE DAY WEEK \n\n 🏈 JUST BECAUSE A COLLEGE LIKES YOUR FILM DOESN'T MEAN THEY HAVE A ROSTER SPOT FOR YOU!\n\nProspects and parents, here's something that many families don't fully understand about college football recruiting.\n\nYOU CAN BE GOOD ENOUGH TO PLAY FOR A COLLEGE PROGRAM AND STILL NOT RECEIVE AN OFFER FROM THAT SCHOOL!\n\nWhy? Because recruiting isn't based solely on talent.\n\nCollege coaching staffs must evaluate their current roster, returning players, positional depth, incoming recruits, transfer portal additions and available financial resources.\n\nUnderstanding how roster needs influence recruiting decisions can help you build a more effective recruiting strategy.\n\n 🔴 FIVE THINGS EVERY PROSPECT NEEDS TO UNDERSTAND\n\n1️⃣ COLLEGE COACHES RECRUIT BASED ON PROGRAM NEEDS.\n\nA college program may love your film but already have several players at your position.\n\nFor example, a school might need three offensive linemen but only one running back in its incoming recruiting class.\n\nThat doesn't mean the running back isn't talented.\n\nIT MEANS THE PROGRAM'S CURRENT ROSTER NEEDS MAY NOT MATCH HIS POSITION!\n\n2️⃣ THE TRANSFER PORTAL CAN AFFECT HIGH SCHOOL RECRUITING.\n\nCollege programs may use the transfer portal to address immediate roster needs.\n\nA coaching staff might decide to recruit an experienced college player rather than a high school prospect who needs additional development.\n\nHowever, other programs may prioritize building through high school recruiting.\n\nDON'T ASSUME EVERY COLLEGE USES THE SAME ROSTER-BUILDING STRATEGY!\n\n3️⃣ ASK WHETHER YOUR POSITION IS A RECRUITING PRIORITY.\n\nWhen communication is permitted, ask college coaches meaningful questions.\n\n🏈 Are you recruiting my position in the Class of 2027?\n\n🏈 How many players are you hoping to bring in at my position?\n\n🏈 Have you evaluated my current film?\n\n🏈 What traits are you looking for at my position?\n\n🏈 What would be the next step in my evaluation?\n\nA coach may not disclose exact roster numbers, but these conversations can help you better understand your recruiting status.\n\n4️⃣ DON'T CONFUSE INTEREST WITH A ROSTER OPPORTUNITY.\n\nA college coach following you on X, inviting you to campus or complimenting your film can be encouraging.\n\nBut those interactions don't automatically mean the program has an available roster spot or scholarship.\n\nPay attention to whether the staff is consistently communicating, requesting information and discussing meaningful next steps.\n\nRECRUITING INTEREST IS ENCOURAGING. A CONFIRMED OPPORTUNITY IS WHAT YOU'RE WORKING TOWARD!\n\n5️⃣ TARGET PROGRAMS THAT HAVE A REALISTIC NEED FOR YOUR ABILITY.\n\nDon't build your entire recruiting list around school names and conference affiliations.\n\nResearch programs at different competitive levels.\n\nStudy their rosters, offensive and defensive systems, and recent recruiting classes.\n\nUse that information to identify potential fits, then confirm actual recruiting needs directly with the coaching staff.\n\nTHE RIGHT PROGRAM ISN'T ALWAYS THE BIGGEST NAME. IT'S THE PROGRAM WHERE YOUR ABILITY, DEVELOPMENT AND OPPORTUNITY ALIGN!\n\n🎯 PARENTS, PAY ATTENTION!\n\nOne of the biggest mistakes families make is assuming that if their athlete is talented enough, every college should be interested.\n\nThat's simply not how roster management works.\n\nA school may already have commitments at your son's position. Another program may be actively searching for an athlete with his exact skill set.\n\nThis is why an honest evaluation and a realistic recruiting strategy matter.\n\nSTOP TAKING EVERY RECRUITING REJECTION PERSONALLY!\n\nSometimes the answer isn't that your athlete can't play at that level.\n\nSometimes the program simply doesn't have the right opportunity available.","createdAt":"2026-11-04T13:06:10.000Z","createdAtUnix":1793797570,"createdAtLabel":null,"language":"en","conversationId":"2117966635403223278","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"CoachDaniels06","displayName":"Coach D","avatarUrl":"https://pbs.twimg.com/profile_images/2069590399488856064/hwb8cPaC_400x400.jpg","profileUrl":"https://x.com/CoachDaniels06","verified":false,"blueVerified":true,"platformUserId":"1553529392365817858","bio":"Founder @RecruitNE_GA LLC the #1 Recruiting source for under the radar prospects/Founder @PSGCAAGame. Proverbs 3:5,6 God's Plan","location":"Georgia, USA","website":"https://recruitnega.us/home/","bannerUrl":"https://pbs.twimg.com/profile_banners/1553529392365817858/1767240616/1500x500","accountCreatedAt":"2022-07-30T23:54:26.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Business","category":[{"id":800,"name":"Sports, Fitness & Recreation","icon_name":"IconBriefcaseStroke"}],"restId":"1636426143011151875"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":116426,"following":24316,"tweets":36513,"favourites":49441,"listedCount":29,"mediaCount":5707}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":24,"retweets":0,"replies":1,"quotes":0,"views":3880,"bookmarkCount":6},"media":[{"url":"https://pbs.twimg.com/media/HWSHbfBWQAALbrr.jpg","type":"photo","width":1439,"height":1433,"id":"2117966631024345088","altText":null}],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"1990458478960476228","url":"https://x.com/coachspeak_pod/status/1990458478960476228","text":"🔁 Have you listened to Episode #40 yet? 🎧🔥\n\nWe sat down with Coach Brian Mahan, Athletic Director at JL Mann High School, to talk all things recruiting, leadership, and program development.\n\nIn this episode, we cover:\n🏈 The truth about the high school recruiting process\n🏈 How coaches can better position their players for exposure\n🏈 Character, academics, and what college recruiters really look for\n🏈 Building The Coach Approach HQ and leading through content\n🏈 Leadership lessons from decades of coaching experience\n\nWhether you’re a coach, parent, or player, this one’s full of real, practical advice for navigating today’s game the right way.\n\n📲 Now streaming on all platforms!","createdAt":"2025-11-17T16:34:16.000Z","createdAtUnix":1763397256,"createdAtLabel":null,"language":"en","conversationId":"1990458478960476228","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"coachspeak_pod","displayName":"Coach Speak®️","avatarUrl":"https://pbs.twimg.com/profile_images/1886516871857405952/XEV30NkW_400x400.png","profileUrl":"https://x.com/coachspeak_pod","verified":false,"blueVerified":true,"platformUserId":"1886516824403312640","bio":"Welcome to Coach Speak. A podcast built for coaches, by coaches. Hosted by @Coach_JBolton and @_Coach_Martin_","location":"Rock Hill, SC","website":"https://linktr.ee/coachspeak_pod","bannerUrl":"https://pbs.twimg.com/profile_banners/1886516824403312640/1768419423/1500x500","accountCreatedAt":"2025-02-03T20:47:26.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Creator","category":[{"id":979,"name":"Podcast","icon_name":"IconBriefcaseStroke"}],"restId":"1886518773189906906"},"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":1430,"following":273,"tweets":635,"favourites":874,"listedCount":3,"mediaCount":365}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":5,"retweets":2,"replies":0,"quotes":0,"views":301,"bookmarkCount":0},"media":[{"url":"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/320x568/noVqZHqigxtEaYTf.mp4?tag=21","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg","contentType":"video/mp4","bitrate":632000,"width":2160,"height":3840,"id":"1990458409741586432","altText":null,"durationMs":39750},{"url":"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/480x852/9et2-K4pKPC-cf02.mp4?tag=21","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg","contentType":"video/mp4","bitrate":950000,"width":2160,"height":3840,"id":"1990458409741586432","altText":null,"durationMs":39750},{"url":"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/720x1280/cwoiXukY59kbdZck.mp4?tag=21","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg","contentType":"video/mp4","bitrate":2176000,"width":2160,"height":3840,"id":"1990458409741586432","altText":null,"durationMs":39750},{"url":"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/1080x1920/fW6ZrCYXmwZNczQj.mp4?tag=21","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg","contentType":"video/mp4","bitrate":10368000,"width":2160,"height":3840,"id":"1990458409741586432","altText":null,"durationMs":39750},{"url":"https://video.twimg.com/amplify_video/1990458409741586432/vid/avc1/2160x3840/Qz8lpFcT70gxG4iI.mp4?tag=21","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/1990458409741586432/img/zoQh__saf3uHJMv5.jpg","contentType":"video/mp4","bitrate":25128000,"width":2160,"height":3840,"id":"1990458409741586432","altText":null,"durationMs":39750}],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2118516001117762039","url":"https://x.com/rekrut_app/status/2118516001117762039","text":"I used to charge families $3,000 to help with recruiting.\n\nToo many kids missed their chance because of the price, not their talent.\n\nWhat I learned: coaches want to hear from the athlete, not from a middleman.\n\nSo I built a platform, not a service. Part 1 of 6. https://x.com/rekrut_app/status/2118516001117762039/video/1","createdAt":"2026-11-06T01:29:09.000Z","createdAtUnix":1793928549,"createdAtLabel":null,"language":"en","conversationId":"2118516001117762039","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"rekrut_app","displayName":"Rekrut | College Recruiting","avatarUrl":"https://pbs.twimg.com/profile_images/2112014794052026368/C8DFmHSQ_400x400.jpg","profileUrl":"https://x.com/rekrut_app","verified":false,"blueVerified":false,"platformUserId":"4607974219","bio":"Smart college recruiting. Get matched to schools that actually fit, not pipe dreams. Coach interviews and recruiting truth weekly. Free profile below.","location":"Arizona, USA","website":"https://rekrut.app/register","bannerUrl":"https://pbs.twimg.com/profile_banners/4607974219/1783960851/1500x500","accountCreatedAt":"2015-12-20T01:10:19.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":null,"metrics":{"availableFields":["followers","following","tweets","favourites","listedCount","mediaCount"],"followers":4648,"following":3061,"tweets":3781,"favourites":2769,"listedCount":9,"mediaCount":2648}},"metrics":{"availableFields":["likes","retweets","replies","quotes","views","bookmarkCount"],"likes":3,"retweets":1,"replies":0,"quotes":0,"views":73,"bookmarkCount":0},"media":[{"url":"https://video.twimg.com/amplify_video/2118515957006204928/vid/avc1/320x568/AgYYGDl6pzLWHQuh.mp4?tag=29","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/2118515957006204928/img/HUaaH7eSy6LApD7l.jpg","contentType":"video/mp4","bitrate":632000,"width":720,"height":1280,"id":"2118515957006204928","altText":null,"durationMs":42056},{"url":"https://video.twimg.com/amplify_video/2118515957006204928/vid/avc1/480x852/n0HICOmBH_wulp_L.mp4?tag=29","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/2118515957006204928/img/HUaaH7eSy6LApD7l.jpg","contentType":"video/mp4","bitrate":950000,"width":720,"height":1280,"id":"2118515957006204928","altText":null,"durationMs":42056},{"url":"https://video.twimg.com/amplify_video/2118515957006204928/vid/avc1/720x1280/QOcTXiJglKXAgpBS.mp4?tag=29","type":"video","thumbnailUrl":"https://pbs.twimg.com/amplify_video_thumb/2118515957006204928/img/HUaaH7eSy6LApD7l.jpg","contentType":"video/mp4","bitrate":2176000,"width":720,"height":1280,"id":"2118515957006204928","altText":null,"durationMs":42056}],"expandedUrl":null,"isRetweet":false,"isReply":false,"isQuote":false,"source":null,"communityId":null,"hasAIGeneratedMedia":false,"isPaidPromotion":false,"isTranslatable":false,"hasBirdwatchNotes":false,"possiblySensitive":false,"entities":{"hashtags":[],"userMentions":[],"urls":[],"symbols":[]},"card":null,"poll":null,"article":null,"place":null,"communityNote":null,"isEdited":false,"quotedTweet":null,"retweetedTweet":null},{"id":"2061593301216567296","url":"https://x.com/TweetsbyCoachP/status/2061593301216567296","text":"One of the reasons youth sports has become so complicated is because everyone involved is often chasing a different definition of success.\n\nOne parent wants college recruiting to be the primary focus. Another wants their child to enjoy the experience and make friends. Another wants championships. Another wants equal playing time. Another believes development matters more than wins. Another believes if you’re paying thousands of dollars, your child should be on the field or court.\n\nNone of those perspectives are necessarily or inherently wrong. They’re just different.\n\nThe challenge is that one coach, one team, and one season cannot satisfy all of them at the same time.\n\nParents are also navigating an increasingly confusing landscape. Travel teams, private trainers, recruiting services, showcases, camps, social media influencers, former players, college coaches, and other parents all offer advice. Often that advice directly contradicts itself.\n\nOne person says play multiple sports. Another says specialize early.\n\nOne person says development matters most. Another says exposure matters most.\n\nOne person says find the best coach. Another says find the team that will give your child the most playing time.\n\nOne person says your child needs more reps. Another says your child needs more rest.\n\nOne person says the child should attend prom and not miss life events. Another says team commitments should come before all else. \n\nFor families investing significant amounts of time and money, it can become incredibly difficult to know who to trust.\n\nThe coaching side is just as complicated.\n\nMost coaches are not showing up every day trying to hold players back, target families, or play favorites. Most genuinely care about their athletes and want them to succeed. But coaches are often forced to make decisions where there are no perfect answers.\n\nShould they prioritize winning or development?\n\nShould they play the senior who has earned it or the younger player with a higher ceiling?\n\nShould they focus on the best interests of one athlete or the best interests of the team?\n\nShould they reward effort, production, leadership, potential, experience, or loyalty?\n\nEvery decision creates a winner and a loser in someone’s eyes.\n\nA coach sees the entire roster. A parent sees their child.\n\nNeither perspective is inherently wrong, but they naturally create conflict.\n\nThe reality is that parents often judge a season through the lens of their child’s experience, while coaches are forced to evaluate it through the lens of the entire team. Those viewpoints frequently collide.\n\nAdd in the emotional investment, financial commitment, social media comparisons, recruiting pressure, and the fact that every child develops at a different pace, and it becomes easy to see why frustration exists.\n\nYouth sports isn’t difficult because people don’t care.\n\nIt’s difficult because everyone cares deeply.\n\nParents care about their children.\n\nCoaches care about their teams.\n\nAthletes care about their opportunities.\n\nAnd when passionate people are pursuing different goals, disagreements are inevitable.\n\nThe best environments aren’t the ones where everyone always agrees. They’re the ones where expectations are clear, communication is honest, trust is built over time, and everyone remembers that there are many different paths to success in sports and in life.","createdAt":"2026-06-01T23:38:40.000Z","createdAtUnix":1780357120,"createdAtLabel":null,"language":"en","conversationId":"2061593301216567296","inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToScreenName":null,"quotedStatusId":null,"retweetTweetId":null,"author":{"handle":"TweetsbyCoachP","displayName":"William Payne","avatarUrl":"https://pbs.twimg.com/profile_images/2108037448278450176/xNRFLgTH_400x400.jpg","profileUrl":"https://x.com/TweetsbyCoachP","verified":false,"blueVerified":true,"platformUserId":"2542103608","bio":"Systemwide Director of Athletics @ Pinecrest Academies of Nevada •🏆 Winning Small College 🏀 Coach • Recruiting • Small College/HBCU Advocate • 📚📕📗📘📙","location":"Henderson, NV","website":"https://www.pinecrestnv.org/","bannerUrl":"https://pbs.twimg.com/profile_banners/2542103608/1787777405/1500x500","accountCreatedAt":"2014-05-12T00:43:06.000Z","privateAccount":false,"verifiedType":null,"affiliateLabel":null,"professional":{"type":"Creator","category":[{"id":800,"name":"Sports, Fitness & Recreation","icon_name":"IconBriefcaseStroke"}],"restId":"1471870317882654720"},"metrics":{"a
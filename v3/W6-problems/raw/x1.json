le\": \"FiredCoaches\",\n          \"displayName\": \"Fired Coaches of Georgia\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2051366630957993984/AM9uHmcd_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/FiredCoaches\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1956526425244119040\",\n          \"bio\": \"The Unofficial Coaches Office of HS Football 🏈 | Commentary + Breaking News + Satire | Can’t tell satire from truth? That’s on you.\",\n          \"location\": \"Georgia, USA\",\n          \"website\": \"https://firedcoaches.org\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1956526425244119040/1787000270/1500x500\",\n          \"accountCreatedAt\": \"2025-08-16T01:20:38.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": {\n            \"type\": \"Creator\",\n            \"category\": [\n              {\n                \"id\": 933,\n                \"name\": \"Media Personality\",\n                \"icon_name\": \"IconBriefcaseStroke\"\n              }\n            ],\n            \"restId\": \"1997505815822102819\"\n          },\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 9986,\n            \"following\": 717,\n            \"tweets\": 3648,\n            \"favourites\": 7414,\n            \"listedCount\": 6,\n            \"mediaCount\": 1102\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 97,\n          \"retweets\": 40,\n          \"replies\": 5,\n          \"quotes\": 13,\n          \"views\": 44112,\n          \"bookmarkCount\": 12\n        },\n        \"media\": [],\n        \"expandedUrl\": \"http://x.com/i/article/2016168849503043584\",\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": \"Twitter Web App\",\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [\n            {\n              \"url\": \"http://x.com/i/article/2016168849503043584\",\n              \"displayUrl\": \"http://x.com/i/article/2016168849503043584\",\n              \"expandedUrl\": \"http://x.com/i/article/2016168849503043584\"\n            }\n          ],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": {\n          \"title\": \"PSA for Parents\",\n          \"previewText\": \"We've all heard the saying: \\\"If something seems too good to be true, it probably is.\\\"  Or, \\\"No such thing as a free lunch\\\". You've likely said it to your own kid at some point. So why does it fall on\",\n          \"id\": \"2016168849503043584\",\n          \"text\": null,\n          \"coverImageUrl\": \"https://pbs.twimg.com/media/G_rqAs2W8AASxQh.jpg\"\n        },\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"2117966635403223278\",\n        \"url\": \"https://x.com/CoachDaniels06/status/2117966635403223278\",\n        \"text\": \"🔑 RECRUITING TIP OF THE DAY WEEK \\n\\n 🏈 JUST BECAUSE A COLLEGE LIKES YOUR FILM DOESN'T MEAN THEY HAVE A ROSTER SPOT FOR YOU!\\n\\nProspects and parents, here's something that many families don't fully understand about college football recruiting.\\n\\nYOU CAN BE GOOD ENOUGH TO PLAY FOR A COLLEGE PROGRAM AND STILL NOT RECEIVE AN OFFER FROM THAT SCHOOL!\\n\\nWhy? Because recruiting isn't based solely on talent.\\n\\nCollege coaching staffs must evaluate their current roster, returning players, positional depth, incoming recruits, transfer portal additions and available financial resources.\\n\\nUnderstanding how roster needs influence recruiting decisions can help you build a more effective recruiting strategy.\\n\\n 🔴 FIVE THINGS EVERY PROSPECT NEEDS TO UNDERSTAND\\n\\n1️⃣ COLLEGE COACHES RECRUIT BASED ON PROGRAM NEEDS.\\n\\nA college program may love your film but already have several players at your position.\\n\\nFor example, a school might need three offensive linemen but only one running back in its incoming recruiting class.\\n\\nThat doesn't mean the running back isn't talented.\\n\\nIT MEANS THE PROGRAM'S CURRENT ROSTER NEEDS MAY NOT MATCH HIS POSITION!\\n\\n2️⃣ THE TRANSFER PORTAL CAN AFFECT HIGH SCHOOL RECRUITING.\\n\\nCollege programs may use the transfer portal to address immediate roster needs.\\n\\nA coaching staff might decide to recruit an experienced college player rather than a high school prospect who needs additional development.\\n\\nHowever, other programs may prioritize building through high school recruiting.\\n\\nDON'T ASSUME EVERY COLLEGE USES THE SAME ROSTER-BUILDING STRATEGY!\\n\\n3️⃣ ASK WHETHER YOUR POSITION IS A RECRUITING PRIORITY.\\n\\nWhen communication is permitted, ask college coaches meaningful questions.\\n\\n🏈 Are you recruiting my position in the Class of 2027?\\n\\n🏈 How many players are you hoping to bring in at my position?\\n\\n🏈 Have you evaluated my current film?\\n\\n🏈 What traits are you looking for at my position?\\n\\n🏈 What would be the next step in my evaluation?\\n\\nA coach may not disclose exact roster numbers, but these conversations can help you better understand your recruiting status.\\n\\n4️⃣ DON'T CONFUSE INTEREST WITH A ROSTER OPPORTUNITY.\\n\\nA college coach following you on X, inviting you to campus or complimenting your film can be encouraging.\\n\\nBut those interactions don't automatically mean the program has an available roster spot or scholarship.\\n\\nPay attention to whether the staff is consistently communicating, requesting information and discussing meaningful next steps.\\n\\nRECRUITING INTEREST IS ENCOURAGING. A CONFIRMED OPPORTUNITY IS WHAT YOU'RE WORKING TOWARD!\\n\\n5️⃣ TARGET PROGRAMS THAT HAVE A REALISTIC NEED FOR YOUR ABILITY.\\n\\nDon't build your entire recruiting list around school names and conference affiliations.\\n\\nResearch programs at different competitive levels.\\n\\nStudy their rosters, offensive and defensive systems, and recent recruiting classes.\\n\\nUse that information to identify potential fits, then confirm actual recruiting needs directly with the coaching staff.\\n\\nTHE RIGHT PROGRAM ISN'T ALWAYS THE BIGGEST NAME. IT'S THE PROGRAM WHERE YOUR ABILITY, DEVELOPMENT AND OPPORTUNITY ALIGN!\\n\\n🎯 PARENTS, PAY ATTENTION!\\n\\nOne of the biggest mistakes families make is assuming that if their athlete is talented enough, every college should be interested.\\n\\nThat's simply not how roster management works.\\n\\nA school may already have commitments at your son's position. Another program may be actively searching for an athlete with his exact skill set.\\n\\nThis is why an honest evaluation and a realistic recruiting strategy matter.\\n\\nSTOP TAKING EVERY RECRUITING REJECTION PERSONALLY!\\n\\nSometimes the answer isn't that your athlete can't play at that level.\\n\\nSometimes the program simply doesn't have the right opportunity available.\",\n        \"createdAt\": \"2026-11-04T13:06:10.000Z\",\n        \"createdAtUnix\": 1793797570,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"2117966635403223278\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"CoachDaniels06\",\n          \"displayName\": \"Coach D\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/2069590399488856064/hwb8cPaC_400x400.jpg\",\n          \"profileUrl\": \"https://x.com/CoachDaniels06\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1553529392365817858\",\n          \"bio\": \"Founder @RecruitNE_GA LLC the #1 Recruiting source for under the radar prospects/Founder @PSGCAAGame. Proverbs 3:5,6 God's Plan\",\n          \"location\": \"Georgia, USA\",\n          \"website\": \"https://recruitnega.us/home/\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1553529392365817858/1767240616/1500x500\",\n          \"accountCreatedAt\": \"2022-07-30T23:54:26.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": {\n            \"type\": \"Business\",\n            \"category\": [\n              {\n                \"id\": 800,\n                \"name\": \"Sports, Fitness & Recreation\",\n                \"icon_name\": \"IconBriefcaseStroke\"\n              }\n            ],\n            \"restId\": \"1636426143011151875\"\n          },\n          \"metrics\": {\n            \"availableFields\": [\n              \"followers\",\n              \"following\",\n              \"tweets\",\n              \"favourites\",\n              \"listedCount\",\n              \"mediaCount\"\n            ],\n            \"followers\": 116426,\n            \"following\": 24316,\n            \"tweets\": 36513,\n            \"favourites\": 49441,\n            \"listedCount\": 29,\n            \"mediaCount\": 5707\n          }\n        },\n        \"metrics\": {\n          \"availableFields\": [\n            \"likes\",\n            \"retweets\",\n            \"replies\",\n            \"quotes\",\n            \"views\",\n            \"bookmarkCount\"\n          ],\n          \"likes\": 24,\n          \"retweets\": 0,\n          \"replies\": 1,\n          \"quotes\": 0,\n          \"views\": 3880,\n          \"bookmarkCount\": 6\n        },\n        \"media\": [\n          {\n            \"url\": \"https://pbs.twimg.com/media/HWSHbfBWQAALbrr.jpg\",\n            \"type\": \"photo\",\n            \"width\": 1439,\n            \"height\": 1433,\n            \"id\": \"2117966631024345088\",\n            \"altText\": null\n          }\n        ],\n        \"expandedUrl\": null,\n        \"isRetweet\": false,\n        \"isReply\": false,\n        \"isQuote\": false,\n        \"source\": null,\n        \"communityId\": null,\n        \"hasAIGeneratedMedia\": false,\n        \"isPaidPromotion\": false,\n        \"isTranslatable\": false,\n        \"hasBirdwatchNotes\": false,\n        \"possiblySensitive\": false,\n        \"entities\": {\n          \"hashtags\": [],\n          \"userMentions\": [],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"1990458478960476228\",\n        \"url\": \"https://x.com/coachspeak_pod/status/1990458478960476228\",\n        \"text\": \"🔁 Have you listened to Episode #40 yet? 🎧🔥\\n\\nWe sat down with Coach Brian Mahan, Athletic Director at JL Mann High School, to talk all things recruiting, leadership, and program development.\\n\\nIn this episode, we cover:\\n🏈 The truth about the high school recruiting process\\n🏈 How coaches can better position their players for exposure\\n🏈 Character, academics, and what college recruiters really look for\\n🏈 Building The Coach Approach HQ and leading through content\\n🏈 Leadership lessons from decades of coaching experience\\n\\nWhether you’re a coach, parent, or player, this one’s full of real, practical advice for navigating today’s game the right way.\\n\\n📲 Now streaming on all platforms!\",\n        \"createdAt\": \"2025-11-17T16:34:16.000Z\",\n        \"createdAtUnix\": 1763397256,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"1990458478960476228\",\n        \"inReplyToStatusId\": null,\n        \"inReplyToUserId\": null,\n        \"inReplyToScreenName\": null,\n        \"quotedStatusId\": null,\n        \"retweetTweetId\": null,\n        \"author\": {\n          \"handle\": \"coachspeak_pod\",\n          \"displayName\": \"Coach Speak®️\",\n          \"avatarUrl\": \"https://pbs.twimg.com/profile_images/1886516871857405952/XEV30NkW_400x400.png\",\n          \"profileUrl\": \"https://x.com/coachspeak_pod\",\n          \"verified\": false,\n          \"blueVerified\": true,\n          \"platformUserId\": \"1886516824403312640\",\n          \"bio\": \"Welcome to Coach Speak. A podcast built for coaches, by coaches. Hosted by @Coach_JBolton and @_Coach_Martin_\",\n          \"location\": \"Rock Hill, SC\",\n          \"website\": \"https://linktr.ee/coachspeak_pod\",\n          \"bannerUrl\": \"https://pbs.twimg.com/profile_banners/1886516824403312640/1768419423/1500x500\",\n          \"accountCreatedAt\": \"2025-02-03T20:47:26.000Z\",\n          \"privateAccount\": false,\n          \"verifiedType\": null,\n          \"affiliateLabel\": null,\n          \"professional\": {\n            \"type\": \"Creator\",\n            \"category\": [\n              {\n                \"id\": 979,\n                \"name\": \"Podcast\",\n                \"icon_name\": \"IconBriefcaseStroke\"\n              }\n            ],\n            \"restId\": \"1886518773189906906\"\n          },\n          \"metrics\": {\
50496\"\n            },\n            {\n              \"handle\": \"newjerseyrise\",\n              \"displayName\": \"New Jersey RISE\",\n              \"platformUserId\": \"4518447317\"\n            },\n            {\n              \"handle\": \"ESBC_BlueFlames\",\n              \"displayName\": \"Empire\",\n              \"platformUserId\": \"701849109355954176\"\n            },\n            {\n              \"handle\": \"NJLadiesHoops\",\n              \"displayName\": \"NJ Ladies Hoops\",\n              \"platformUserId\": \"1037996244\"\n            },\n            {\n              \"handle\": \"TinyGreenNBS\",\n              \"displayName\": \"Coach Tiny Green\",\n              \"platformUserId\": \"1021745572036927488\"\n            },\n            {\n              \"handle\": \"coachschoiceusa\",\n              \"displayName\": \"COACH'S CHOICE USA\",\n              \"platformUserId\": \"956542536\"\n            }\n          ],\n          \"urls\": [],\n          \"symbols\": []\n        },\n        \"card\": null,\n        \"poll\": null,\n        \"article\": null,\n        \"place\": null,\n        \"communityNote\": null,\n        \"isEdited\": false,\n        \"quotedTweet\": null,\n        \"retweetedTweet\": null\n      },\n      {\n        \"id\": \"2117738960784912856\",\n        \"url\": \"https://x.com/diamondconnbsb/status/2117738960784912856\",\n        \"text\": \"Recruiting has two jobs:\\n\\nParent: proofread, organize the school list, handle logistics, ask the money and academic questions on visits.\\n\\nPlayer: write, send, and talk with coaches.\\n\\nCoaches want to know they're recruiting the player, not the parent. https://x.com/diamondconnbsb/status/2117738960784912856/photo/1\",\n        \"createdAt\": \"2026-11-03T22:01:28.000Z\",\n        \"createdAtUnix\": 1793743288,\n        \"createdAtLabel\": null,\n        \"language\": \"en\",\n        \"conversationId\": \"2117738960784912856\",\n        \"inReplyToStatusId\": null,\n       
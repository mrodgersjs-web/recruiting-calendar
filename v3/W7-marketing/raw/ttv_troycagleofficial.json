_desc\": \"[\\\"What to say when a college coach tells you they like your film\\\",\\\"\\\",\\\"Just because a coach compliments your film does not mean an offer is on the way \\\\ud83d\\\\udc47\\\",\\\"\\\",\\\"Never just say “thanks coach”: Short dry responses kill the conversation and give the coach no reason to keep it going\\\",\\\"\\\",\\\"Lead with gratitude: Thank the coach for the compliment and for taking the time to watch your video. This sets the tone the right way\\\",\\\"\\\",\\\"Lower the pressure: Let the coach know you do not want to take up too much of their time and that you just have one quick question. Respecting their time makes them way more likely to engage\\\",\\\"\\\",\\\"Push the conversation forward: Ask if it makes sense to have a phone call to learn more about their program or if there is a better next step they have in mind. This turns a compliment into an actual conversation\\\",\\\"\\\",\\\"Compliments are not commitments \\\\ud83c\\\\udfaf keep the conversation moving and you keep the offer alive\\\",\\\"\\\",\\\"#collegerecruiting #scholarship #scholarships\\\"]\",\n          \"content_desc_extra\": [\n            {\n              \"start\": 0,\n              \"end\": 18,\n              \"type\": 1,\n              \"hashtag_name\": \"collegerecruiting\",\n              \"hashtag_id\": \"1631173137289221\",\n              \"is_commerce\": false,\n              \"line_idx\": 14,\n              \"tag_id\": \"1000\"\n            },\n            {\n              \"start\": 19,\n              \"end\": 31,\n              \"type\": 1,\n              \"hashtag_name\": \"scholarship\",\n              \"hashtag_id\": \"256352\",\n              \"is_commerce\": false,\n              \"line_idx\": 14,\n              \"tag_id\": \"1001\"\n            },\n            {\n              \"start\": 32,\n              \"end\": 45,\n              \"type\": 1,\n              \"hashtag_name\": \"scholarships\",\n              \"hashtag_id\": \"793635\",\
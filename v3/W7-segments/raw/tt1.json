WithoutWatermarkUrl\": null\n        }\n      },\n      {\n        \"id\": \"7609742195561696525\",\n        \"caption\": \"\\\"Dad over 40- don't do it\\\"\",\n        \"createdAt\": \"2026-02-22T17:26:46.000Z\",\n        \"url\": \"https://www.tiktok.com/@burbnbougie2026/video/7609742195561696525\",\n        \"thumbnailUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast5-p-0068-tx/oopNkQTgMjeVnCeSAQ8KAoFkyX76bTHIbe8jns~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast5&ps=13740610&refresh_token=56722661&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=k2oYB6UYxpgPLHYGYpK9BJTFeMc%3D\",\n        \"durationMs\": 791834,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 49783,\n          \"likes\": 2926,\n          \"comments\": 99,\n          \"shares\": 67,\n          \"saves\": 247\n        },\n        \"media\": {\n          \"downloadUrl\": null,\n          \"downloadWithoutWatermarkUrl\": null\n        }\n      },\n      {\n        \"id\": \"7323694672046460190\",\n        \"caption\": \"A big mistake parents make in the recruiting process\",\n        \"createdAt\": \"2024-01-13T21:16:22.000Z\",\n        \"url\": \"https://www.tiktok.com/@trentonluera14/video/7323694672046460190\",\n        \"thumbnailUrl\": \"https://p16-common-sign.tiktokcdn-us.com/tos-useast8-p-0068-tx2/oMle5GsIqBLfQNLeRAnFvUWaflGLiA4lIQXFCY~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast5&ps=13740610&refresh_token=21302dac&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=AbkwUdY%2BUOw6holth%2Fbd1JBr8Fw%3D\",\n        \"durationMs\": 57023,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 328,\n          \"likes\": 21,\n          \"comments\": 0,\n          \"shares\": 0,\n          \"saves\": 1\n        },\n        \"media\": {\n          \"downloadUrl\": null,\n          \"downloadWithoutWatermarkUrl\": null\n        }\n      },\n      {\n        \"id\": \"7688715707298647327\",\n        \"caption\": \"When I was a Michigan Guard recruiter I had a Nextel. If you didn’t lock the settings, every incoming message chirped out loud for the whole room. I enlisted a kid named Andrew. Took him three tries to pass the test. I got way too close with his parents. One day he’s in my office filling out paperwork. Phone chirps. It’s his mom telling the whole room she’s pregnant and she’s sure it’s mine. He threatened to turn me in. I told him to stand at parade rest. They later said they were keeping the baby and we were done. I transferred to Ypsilanti. Moral: don’t let your kinks run your life. Hear the rest live. Tickets, merch, and Cameo at www.jwvest.com. September 26 – Story Time with Jason Vest (Birthday Show), Green Room ATX #nationalguard #recruiter #nextel #storytime\",\n        \"createdAt\": \"2026-09-23T13:03:57.000Z\",\n        \"url\": \"https://www.tiktok.com/@poopyturdsmcgee1.5/video/7688715707298647327\",\n        \"thumbnailUrl\": \"https://p19-common-sign.tiktokcdn-us.com/tos-useast8-p-0068-tx2/o0EExrq2KzRDEAJEF8AyRIIDzAQVsxWBEwfKke~tplv-tiktokx-cropcenter:500:800.jpeg?biz_tag=musically_video.video_cover&dr=9638&idc=useast5&ps=13740610&refresh_token=baffee78&shcp=9b759fb9&shp=c1333099&t=4d5b0474&x-expires=1794002400&x-signature=3X8wBd%2FUBfZKeeoPg07aopoDoto%3D\",\n        \"durationMs\": 446914,\n        \"pinned\": false,\n        \"isAd\": false,\n        \"stats\": {\n          \"views\": 490457,\n          \"likes\": 80376,\n          \"comments\": 2476,\n          \"shares\": 40472,\n          \"saves\": 12625\n        },\n        \"media\": {\n          \"downloadUrl\": \"https://v16m.tiktokcdn-us.com/559c634a1ff626f591e19079152c618d/6aee5d4b/video/tos/useast8/tos-useast8-pve-0068-tx2/oYfxzGAAEQBEYWAJeQDDVqEusImr1zRP8FEEW2/?a=1233&bti=NEBzNTY6QGo6OjZALnAjNDQuYCMxNDNg&&bt=703&ft=BIcq8V~3wUxl7K2gUtIvk84jWLpi_J
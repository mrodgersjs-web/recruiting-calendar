data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5Mzk5NDIxNDExNDM1\",\n        \"text\": \"Congratulations to your son. The process is actually awful and very stressful for the child and their family. Please keep in mind nothing is perfect.\",\n        \"createdAt\": \"2026-05-04T03:04:55.000Z\",\n        \"replyCount\": 3,\n        \"reactionCount\": 3,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Tuckertoo2_\",\n          \"platformUserId\": \"5278665205692681\",\n          \"shortName\": null\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5MjIwOTg4MDk1OTQ1\",\n        \"text\": \"Congratulations!! That is very exciting! If you need any advice with your 2028, feel free to reach out! colleen@accrecruits.com\",\n        \"createdAt\": \"2026-05-03T20:46:14.000Z\",\n        \"replyCount\": 1,\n        \"reactionCount\": 1,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Colleen Kelly\",\n          \"platformUserId\": \"pfbid02bZYVfymP78wkUUy5LERRaM8usBKGR1Cn6ZjjCmkrr9fshQThMFF1fNKpeYJUp5XSl\",\n          \"shortName\": \"Colleen\"\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5MTA0ODE0Nzc0MjI5\",\n        \"text\": \"My daughter's long time boyfriend (and club and college teammate) did not commit until early 2022 (he was a 2022 high school graduate). He was 7th in the 100 breast at the NCAA D1 Championships in March. Moral of the story: it is not too late to find your fit, even in your senior year of high school.\",\n        \"createdAt\": \"2026-05-03T17:14:20.000Z\",\n        \"replyCount\": 0,\n        \"reactionCount\": 5,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"John W. Hartel\",\n          \"platformUserId\": \"pfbid0U4ZTzjv71AP9qR1xdvarQuRNjwV7X65actrinMJXDaJ3QXrh4U4hXFoqW6vzmaCAl\",\n          \"shortName\": \"John\"\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5MDc3ODY0Nzc2OTI0\",\n        \"text\": \"Good for you and your swimmer. It’s your swimmer’s decision and it happens best when they own their process.\",\n        \"createdAt\": \"2026-05-03T16:33:28.000Z\",\n        \"replyCount\": 0,\n        \"reactionCount\": 2,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Greg Tucker\",\n          \"platformUserId\": \"pfbid02c4vNDG9ezu7aFvfU16oc9k4jmHsR9rYGBh4HdLJFMAUjRF5VNMJnUBcTh1Ja4vUwl\",\n          \"shortName\": \"Greg\"\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTUyMzIwNzE0NDUyNjM5\",\n        \"text\": \"You touched my heart! As a mom it is hard to watch your kid dealing with school, practices, meets and waiting for a coach to reply her email\",\n        \"createdAt\": \"2026-05-07T18:53:59.000Z\",\n        \"replyCount\": 0,\n        \"reactionCount\": 0,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Anonymous participant 454\",\n          \"platformUserId\": \"2219120168833533\",\n          \"shortName\": null\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5MjMxNDQ4MDk0ODk5\",\n        \"text\": \"Congratulations to your son!! Can I ask where he is going\",\n        \"createdAt\": \"2026-05-03T21:07:16.000Z\",\n        \"replyCount\": 1,\n        \"reactionCount\": 1,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"BeautifulPhoenix9090\",\n          \"platformUserId\": \"1382402496960941\",\n          \"shortName\": null\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTUyODgzODQ3NzI5NjU5\",\n        \"text\": \"Congratulations that’s amazing!!!!\",\n        \"createdAt\": \"2026-05-08T12:26:47.000Z\",\n        \"replyCount\": 0,\n        \"reactionCount\": 0,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Dana Redwine White\",\n          \"platformUserId\": \"1204923889\",\n          \"shortName\": \"Dana\"\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5Nzg0OTk0NzA2MjEx\",\n        \"text\": \"Congratulations! 💙\",\n        \"createdAt\": \"2026-05-04T14:21:07.000Z\",\n        \"replyCount\": 0,\n        \"reactionCount\": 0,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Jennifer Baldwin Corvin\",\n          \"platformUserId\": \"pfbid0yHW1gumDTUokx7KUPgWjUBZzNrnuHsAzXuSgABFktqMPDG38VpVZZ2LXEYtJbUh6l\",\n          \"shortName\": \"Jennifer\"\n        }\n      },\n      {\n        \"id\": \"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTUyMDMyNTAxMTQ4MTI3\",\n        \"text\": \"🙂‍↔️\",\n        \"createdAt\": \"2026-05-07T11:14:46.000Z\",\n        \"replyCount\": 0,\n        \"reactionCount\": 0,\n        \"repliesCursor\": \"\",\n        \"author\": {\n          \"name\": \"Renee Balthazar\",\n          \"platformUserId\": \"pfbid02dgjS3MU4U73KpUaszBZGy3pXNsYsNcnEaZQiXBEwouJoTZwdFeqb6WaTVJzzNMFkl\",\n          \"shortName\": \"Renee\"\n        }\n      }\n    ],\n    \"page\": {\n      \"nextCursor\": null,\n      \"hasMore\": false\n    }\n  },\n  \"meta\": {\n    \"requestId\": \"req_ed345ac1-dc83-4c0d-b0e0-492b0d5a35ed\",\n    \"creditsCharged\": 1,\n    \"version\": \"v1\"\n  }\n}"},{"type":"text","text":"{\"conversation_id\":\"01a1b1d0-1a80-73bb-949d-7894e326e364\"}"}],"structuredContent":{"data":{"lookupStatus":"found","comments":[{"id":"Y29tbWVudDo5NDg5NTI5MzQ3ODk0MTdfOTQ5Mzk5NDIxNDExNDM1","text":"Congratulations to your son. The process is actually awful and very stressful for the child and their family. Please keep in mind nothing is perfect.","createdAt":"2026-05-04T03:04:55.000Z","replyCount":3,"reactionCount":3,"repliesCursor":"","author":{"name":"Tuckertoo2_","platformUserId":"5278665205692681","shortName":null}},
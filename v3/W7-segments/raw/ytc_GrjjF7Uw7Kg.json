data: {"result":{"content":[{"type":"text","text":"{\n  \"data\": {\n    \"lookupStatus\": \"found\",\n    \"comments\": [\n      {\n        \"id\": \"UgyLEdY1rLePlC_AEYB4AaABAg\",\n        \"text\": \"I just got a text and missed call NCSA for my son. Your video is extremely helpful.I will be showing this video to my son. Sincerely Thank You.\",\n        \"createdAt\": \"2023-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"3 years ago\",\n        \"likeCount\": 30,\n        \"replyCount\": 3,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd5TEVkWTFyTGVQbENfQUVZQjRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3lMRWRZMXJMZVBsQ19BRVlCNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"becca618\",\n          \"displayName\": \"@becca618\",\n          \"platformUserId\": \"UC1eZbaE2APhHCh-OPiwLv6g\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/PffSR7Sq5fRKuvt1Smlkg1e8Wml8R0hDlLzm54DuF7ZmOb1KtzGLXBlMJXy61mM6biRgWeo_=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@becca618\"\n        }\n      },\n      {\n        \"id\": \"UgzyRv_5HWvBx7vSwCx4AaABAg\",\n        \"text\": \"Looks like your hard work paid off Richie, congrats. As a Former D1 athlete and HS coach with many of my former athletes earning scholarships. If your athlete is good, they will find them. Have them focus on GRADES and their sports fundamentals. Matter of fact have them play every sport they can as each teaches a different skill set. The unfortunate truth is that a lot of parents think their child is a lot better than what they really are and live vicariously through them. Some kids are great HS athletes but not college material that's why grades are so important. (Not to mention - seen it a bunch of times- they end up with an academic scholarship) Most HSs have all the equipment needed to work out and a coach to help them.(You don't need much, an open field where you can run, jump, pushups, pullups list goes on, their is no bench press on the fifty yard line) Not to mention, just about every HS has HUDL, and that's what the coaches want. Every conversation I have ever had with a coach about one of my guys all ended the same way, \\\"Send me their HUDL video.\\\" Bottom line is they need to ball out and be an impact player. Even if they are at a school that is not that great, they will have a powerhouse on their schedule that allows them the opportunity to showcase their talents against a top tier opponent. Lastly, one of the biggest things now is social media presence. What they do off the field is just as important. No stupid posts.\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 5,\n        \"replyCount\": 2,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd6eVJ2XzVIV3ZCeDd2U3dDeDRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3p5UnZfNUhXdkJ4N3ZTd0N4NEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"coachmolina4060\",\n          \"displayName\": \"@coachmolina4060\",\n          \"platformUserId\": \"UC-mBqZm7TvqWbBa3OpMn8tg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_mC8xjS7E0K2jan_A9yI6F80yF8vf1WR_lrzwU8Mq4uGQ=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@coachmolina4060\"\n        }\n      },\n      {\n        \"id\": \"Ugzn8TbT2f4jgZxXyaF4AaABAg\",\n        \"text\": \"My daughter got a full ride scholarship because of NSCA. I highly recommend it.\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 3,\n        \"replyCount\": 2,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd6bjhUYlQyZjRqZ1p4WHlhRjRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3puOFRiVDJmNGpnWnhYeWFGNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"chadklotz5494\",\n          \"displayName\": \"@chadklotz5494\",\n          \"platformUserId\": \"UCR9cBtWsxVoaR6vg0zs9xCw\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_nAdJiOLBDFatoeGmBuzlRVNtDQMnMk4rR7B5vsLZVWKA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@chadklotz5494\"\n        }\n      },\n      {\n        \"id\": \"UgxpNDIWndazy7TZA3V4AaABAg\",\n        \"text\": \"Your kid if he is good will get recognized based on his talent and numbers that are shared nation wide you don't need to pay these people.  Our son has full ride offers NCSA did nothing to promote him.  They only sent us spam from colleges that bought advertising space from them.\",\n        \"createdAt\": \"2024-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"2 years ago\",\n        \"likeCount\": 2,\n        \"replyCount\": 3,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd4cE5ESVduZGF6eTdUWkEzVjRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3hwTkRJV25kYXp5N1RaQTNWNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"kneedragon76\",\n          \"displayName\": \"@kneedragon76\",\n          \"platformUserId\": \"UCTpW7Yn9_kxsszJKI9JuKCA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/30JtnWXLdHRMJ635aFerA5jSvdAn2yRvO6hR-lP1EdbCWVXxeqWsQnoJ57t1vBYgmwVylJHl4NU=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@kneedragon76\"\n        }\n      },\n      {\n        \"id\": \"Ugw1t_El5PY6B7BM5uB4AaABAg\",\n        \"text\": \"Id like a free copy.\",\n        \"createdAt\": \"2026-02-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"9 months ago\",\n        \"likeCount\": 2,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd3MXRfRWw1UFk2QjdCTTV1QjRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3cxdF9FbDVQWTZCN0JNNXVCNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"TheBodyArtistTV\",\n          \"displayName\": \"@TheBodyArtistTV\",\n          \"platformUserId\": \"UC0Jji4hgzzBML7X2P3ZWR-g\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_kweGmM58_tLc2_5astl99mPjdVTauD-nn-oCU0Kds=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@TheBodyArtistTV\"\n        }\n      },\n      {\n        \"id\": \"UgyRVtfyfRabAcACzlV4AaABAg\",\n        \"text\": \"I just have call from than I was confused. Thank you for the information.\",\n        \"createdAt\": \"2026-10-23T17:01:13.912Z\",\n        \"publishedTimeText\": \"2 weeks ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"Marelyn504\",\n          \"displayName\": \"@Marelyn504\",\n          \"platformUserId\": \"UCvfYHB55vH5CFsZE0YCCtng\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_lCcLaQxWcvI2EGO1Yx8JghVogwuIvweQtKO2WljVQO8Z9U-9WIqXep9b4I_4RwnbLfMQ=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@Marelyn504\"\n        }\n      },\n      {\n        \"id\": \"UgyM8QxEgvyAWvlRaFZ4AaABAg\",\n        \"text\": \"Great video! Go Bears!\",\n        \"createdAt\": \"2024-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"2 years ago\",\n        \"likeCount\": 3,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"mutsubui\",\n          \"displayName\": \"@mutsubui\",\n          \"platformUserId\": \"UCJBfIhrdFpxa718LDCmqCTA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_m8O5w_j9zDbpfVle7WDDHNumeFKxsB9I3LueBGYq97mQ=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@mutsubui\"\n        }\n      },\n      {\n        \"id\": \"Ugz8UEcqU8N9kJTh3uJ4AaABAg\",\n        \"text\": \"I hate hate hate the recruiting process. Student athletes are STUDENTS first, coaches expecting these children...and that's what they are to have marketing savvy, maintain grades and be in peak physical condition with the massive pressure of a single decision altering their lifelong dream. No wonder kids burn out, have panic attacks and quit. Loads of heavily recruited sports have no professional outlet or earnings, so if you pour god knows how much money into a hobby just know what you're doing,  you're paying for college before you hopefully don't have to pay for college.\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 3,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd6OFVFY3FVOE45a0pUaDN1SjRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3o4VUVjcVU4TjlrSlRoM3VKNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"dominickbrookes5103\",\n          \"displayName\": \"@dominickbrookes5103\",\n          \"platformUserId\": \"UC0Tyx7WDUorzjSmNBpEWgbA\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_lTztAyRku4Lq_hg_wZx56mnIx9-RRUXcgGOc1D3I4=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@dominickbrookes5103\"\n        }\n      },\n      {\n        \"id\": \"UgzKHZe1J36rqR0J6Qp4AaABAg\",\n        \"text\": \"Wow this was a great video! Thank you\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 1,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"1Blantdaddy\",\n          \"displayName\": \"@1Blantdaddy\",\n          \"platformUserId\": \"UCd_DUnVOeTc14z9mQpsPF9g\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/rzo9rJd897MsdGqt6EE_OR9wD7yx4qI_DTikbgM9FOcrX3wUTOakN3Np9rLYxGq9xlcOilfHLrc=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@1Blantdaddy\"\n        }\n      },\n      {\n        \"id\": \"Ugz5RnfDBKd8e9SI0S54AaABAg\",\n        \"text\": \"My son is on ncsa but he got a top tier scholarship we haven't paid a dime. He has 2 d1 schools 12 d2 schools a couple d3 schools following him. He just finished his sophomore year. I've learned alot but its all real confusing. He is on the eybl circuit that seems to have caught more attention than anything.good video and im subscribing\",\n        \"createdAt\": \"2026-07-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"4 months ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"jackhart5045\",\n          \"displayName\": \"@jackhart5045\",\n          \"platformUserId\": \"UCm-LnTpbTRy0KCMQq_wtUyw\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/zBlRFC1EecbdyyJYH4cfMwoy_5KMj3IEOXAHZTHpXEl0M36T0IT_375-rjge3ElchAo6HH3gWg=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@jackhart5045\"\n        }\n      },\n      {\n        \"id\": \"Ugz9nCtaHaojQaiWceB4AaABAg\",\n        \"text\": \"I'm putting my daughter in NCSA. Appreciate the insight\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 1,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"earnestjones-sh3oh\",\n          \"displayName\": \"@earnestjones-sh3oh\",\n          \"platformUserId\": \"UCNnAQflKnJTu2GKT6-iLBcg\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/ytc/AIdro_nSfvpwx2PhzSyU_M9n8lYAW4FpFEtfDQKtXbsvQ-B6gqpO6a-tAgKgrKCG1CzDX25FcA=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@earnestjones-sh3oh\"\n        }\n      },\n      {\n        \"id\": \"Ugw05jnhDffP73wY2m94AaABAg\",\n        \"text\": \"Great advice! I spoke to a recruiter yesterday and this video has helped me to make a right decision. Thanks\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 4,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd3MDVqbmhEZmZQNzN3WTJtOTRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3cwNWpuaERmZlA3M3dZMm05NEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"héritiernosso-w6x\",\n          \"displayName\": \"@héritiernosso-w6x\",\n          \"platformUserId\": \"UCT6SkPelvg4TN78pJXySS-g\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/2BmB7UcCdmqV5KXv05q2kpxPaE7Zq3n90odQfdeJPldQHeZbc7xKiPCvwbyMRA2G_pQXTzLeTw=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@h%C3%A9ritiernosso-w6x\"\n        }\n      },\n      {\n        \"id\": \"UgwbttpEsaNnXbGbsvh4AaABAg\",\n        \"text\": \"Just set up our....to me is it safe to say that if your kid is a superior Athlete do they really need a service like this?\",\n        \"createdAt\": \"2025-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"1 year ago\",\n        \"likeCount\": 2,\n        \"replyCount\": 0,\n        \"repliesCursor\": null,\n        \"author\": {\n          \"handle\": \"MarkEElmo\",\n          \"displayName\": \"@MarkEElmo\",\n          \"platformUserId\": \"UCkiI_lKQl8xv1xZXCoDevFQ\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/-g-pnyQakMNS-U4KhpneB5EIi9895sImC8mFYsvwkNZ29qZAI_NNMdVBIwkjF4dS-6Vx6Uc6Y1M=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@MarkEElmo\"\n        }\n      },\n      {\n        \"id\": \"Ugw9g6mOoeymbIRLDOZ4AaABAg\",\n        \"text\": \"Great and informative video, Richie. Ordered the book. Wish you luck!!!! Greetings from Lithuania!!!\",\n        \"createdAt\": \"2024-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"2 years ago\",\n        \"likeCount\": 5,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd3OWc2bU9vZXltYklSTERPWjRBYUFCQWciAggAKhhVQ1V0OUJEXzlNUDJiTFQ4OUJ0VkI4ZXcyC0dyampGN1V3N0tnQAFICoIBAggBQi9jb21tZW50LXJlcGxpZXMtaXRlbS1VZ3c5ZzZtT29leW1iSVJMRE9aNEFhQUJBZw%3D%3D\",\n        \"author\": {\n          \"handle\": \"JusteVilimaiteVolley\",\n          \"displayName\": \"@JusteVilimaiteVolley\",\n          \"platformUserId\": \"UCzuWadOINosX9szz1cGZrFw\",\n          \"verified\": false,\n          \"creator\": false,\n          \"avatarUrl\": \"https://yt3.ggpht.com/JVbKVi5AdbI7HQz_B60zqse6wqnBobzw4d4j1-fawdnJvgfTzX9qN-nbOdYxrhVK33T0rF6j5Ng=s88-c-k-c0x00ffffff-no-rj\",\n          \"channelUrl\": \"https://youtube.com/@JusteVilimaiteVolley\"\n        }\n      },\n      {\n        \"id\": \"UgzbRZjhIkEvfWomXsx4AaABAg\",\n        \"text\": \"Thank you . Very helpful\",\n        \"createdAt\": \"2024-11-06T17:01:13.912Z\",\n        \"publishedTimeText\": \"2 years ago\",\n        \"likeCount\": 0,\n        \"replyCount\": 1,\n        \"repliesCursor\": \"Eg0SC0dyampGN1V3N0tnGAYygwEaUBIaVWd6YlJaa